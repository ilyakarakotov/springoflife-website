# Copy to .env for local runs (`npm run sync` reads it). Never commit .env.
# In GitHub Actions these come from repository Secrets (PCO_*) and Variables (the rest).

# pco = production (official API, Personal Access Token)
# churchcenter = prototype only (undocumented Church Center web API, no token)
SYNC_ADAPTER=pco

# Personal Access Token from https://api.planningcenteronline.com/oauth/applications
# (the person who creates it needs Registrations administrator + Groups viewer access)
PCO_APP_ID=
PCO_SECRET=

# Planning Center IDs. Matched by ID, so renaming the category or group type is safe.
PCO_WEBSITE_CATEGORY_ID=111199     # Registrations category "Website Category "
PCO_LIFE_GROUP_TYPE_ID=222818      # Groups type "English Life Groups"

# Public site address, used by the sync for links in the ICS feed and the digest.
# The build (npm run build) does NOT read this file: pass SITE_URL / BASE_PATH / PREVIEW on the
# command line, e.g.  SITE_URL=https://<owner>.github.io/springoflife-website/ PREVIEW=true npm run build
SITE_URL=https://springoflifechurch.com

# Rarely needed:
# ALLOW_PROTOTYPE_ADAPTER=1        # only matters in GitHub Actions: lets SYNC_ADAPTER=churchcenter run there
# SYNC_ALLOW_EMPTY=1               # accept an empty list when the site still lists 3+ current items
# SYNC_NOW=2026-10-05T12:00:00Z    # pretend it's another time (testing the "ended event" logic)
# CHURCH_CENTER_URL=https://springoflifechurch.churchcenter.com
