{
  "name": "sol-website",
  "private": true,
  "type": "module",
  "description": "Spring of Life Church English website (Astro, static) with a deterministic Planning Center sync.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "node --env-file-if-exists=.env scripts/sync.mjs",
    "sync:cc": "SYNC_ADAPTER=churchcenter node --env-file-if-exists=.env scripts/sync.mjs",
    "test": "node --test \"scripts/test/*.test.mjs\"",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.5",
    "htmlparser2": "12.0.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
