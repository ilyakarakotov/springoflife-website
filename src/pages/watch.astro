---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SermonEmbed from '../components/SermonEmbed.astro';
import { site } from '../lib/content';
---
<Base title="Watch" description="Watch the latest sermon from Spring of Life Church, or join the English service live on YouTube every Sunday at 12:00 pm.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Watch</span>
      <h1>Sermons and live stream</h1>
      <p class="lead">Catch up on the latest message, or join us live on YouTube every {site.service.day} at {site.service.time}.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap watch">
      <div>
        <h2 class="h3">Latest sermon</h2>
        <SermonEmbed eager />
        <p class="muted small">The newest sermon appears here automatically after it's posted to our app.</p>
      </div>
      <aside class="watch-side">
        <div class="card side-card live">
          <span class="eyebrow">Live on Sundays</span>
          <h2 class="h3">Join the service at {site.service.time}</h2>
          <p class="muted">The English service streams live on our YouTube channel.</p>
          <a class="btn btn--primary" href={site.links.youtube_live} target="_blank" rel="noopener"><Icon name="youtube" />Watch live on YouTube</a>
        </div>
        <div class="card side-card">
          <ul class="links">
            <li><a href={site.links.sermons} target="_blank" rel="noopener"><span><b>All sermons</b><small>Series, speakers and past messages</small></span><Icon name="external" /></a></li>
            <li><a href={site.links.youtube} target="_blank" rel="noopener"><span><b>YouTube channel</b><small>Spring of Life Church | English</small></span><Icon name="external" /></a></li>
            <li><a href={site.links.bulletin} target="_blank" rel="noopener"><span><b>Weekly bulletin</b><small>Announcements and sermon notes</small></span><Icon name="external" /></a></li>
            <li class="app-row"><span><b>Spring of Life app</b><small>Sermons on your phone</small></span><span class="app-links"><a href={site.links.app_ios} target="_blank" rel="noopener">iPhone</a><span aria-hidden="true">·</span><a href={site.links.app_android} target="_blank" rel="noopener">Android</a></span></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .watch { display: grid; gap: 24px; }
  @media (min-width: 1024px) { .watch { grid-template-columns: 1.7fr 1fr; align-items: start; } }
  .h3 { font-size: var(--step-2); }
  .small { font-size: 0.9rem; margin-top: 0.75rem; }
  .watch-side { display: grid; gap: 16px; }
  .side-card { padding: clamp(20px, 3vw, 30px); }
  .live { background: var(--bg-tint); border-color: transparent; }
  .links { list-style: none; margin: 0; padding: 0; }
  .links li + li { border-top: 1px solid var(--border); }
  .links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; text-decoration: none; }
  .links a:hover b { text-decoration: underline; text-underline-offset: 3px; }
  .links span { display: grid; }
  .links small { color: var(--muted); font-size: 0.88rem; }
  .app-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; }
  .app-links { display: inline-flex; gap: 0.5rem; font-weight: 700; }
  .links .app-links a { display: inline; padding: 0; color: var(--accent-text); text-underline-offset: 3px; }
</style>
