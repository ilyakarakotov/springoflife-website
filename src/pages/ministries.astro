---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MinistryCard from '../components/MinistryCard.astro';
import PageHero from '../components/PageHero.astro';
import ClosingInvite from '../components/ClosingInvite.astro';
import { ministries, external } from '../lib/content';
import { href } from '../lib/url';

const sections = [
  { id: 'kids', title: 'Kids and teens', lead: 'Sunday school, AWANA, the kids choir and teens.' },
  { id: 'adults', title: 'Groups and adults', lead: 'Life Groups, young adults and missions.' },
  { id: 'schools', title: 'Schools', lead: 'Investing in the next generation.' },
  { id: 'serve', title: 'Serve', lead: 'Use your gifts to serve the church.' },
] as const;
// A section shows only when it has a card (cards whose text is still a placeholder are left out).
const visible = sections.map((s) => ({ ...s, items: ministries.filter((m) => m.group === s.id) })).filter((s) => s.items.length > 0);
// Four cards go 2 + 2 or 4 across instead of leaving one alone on a row.
const gridFor = (n: number) => (n === 4 ? 'grid--4' : n === 2 ? 'grid--2' : 'grid--3');
---
<Base title="Ministries" description="Ministries at Spring of Life Church: AWANA, kids choir, teens, Life Groups, young adults, SOL Music Academy, SOL Russian School and more.">
  <PageHero eyebrow="Ministries" title="Grow with us"
    lead="From AWANA on Wednesday nights to Life Groups during the week, here's what happens at Spring of Life beyond Sunday. Registration for each program is on Church Center, and every button below points to this year's signup.">
    <nav class="jump" aria-label="Ministry sections">
      {visible.map((s) => <a class="chip" href={`#${s.id}`}>{s.title}</a>)}
      <a class="chip" href={href('/life-groups')}>Life Groups</a>
    </nav>
  </PageHero>

  {visible.map((s, i) => s.id === 'serve' && s.items.length === 1 ? (
    /* A single serving card reads better as a band with one action. */
    <section class="section section--tint serve-band" id={s.id} aria-labelledby={`${s.id}-title`}>
      <div class="wrap serve" id={s.items[0].id}>
        <div data-reveal>
          <span class="eyebrow eyebrow--accent eyebrow--wave">{s.title}</span>
          <h2 id={`${s.id}-title`}>{s.items[0].title}</h2>
          <p>{s.items[0].summary}</p>
        </div>
        {s.items[0].href && s.items[0].cta && (
          <div data-reveal><a class="btn btn--primary" href={href(s.items[0].href)} {...external(s.items[0].href)}>{s.items[0].cta}<Icon name="external" /></a></div>
        )}
      </div>
    </section>
  ) : (
    <section class:list={['section', { 'section--soft': i % 2 === 1 }]} id={s.id} aria-labelledby={`${s.id}-title`}>
      <div class="wrap">
        <div class="section-head"><div><h2 id={`${s.id}-title`} data-reveal="lines">{s.title}</h2><p class="lead" data-reveal>{s.lead}</p></div></div>
        <div class:list={['grid', 'ministries', gridFor(s.items.length)]}>
          {s.items.map((m) => <MinistryCard item={m} media={s.items.some((x) => x.image)} />)}
        </div>
      </div>
    </section>
  ))}

  <ClosingInvite />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  section[id] { scroll-margin-top: 72px; }
  .ministries { row-gap: clamp(40px, 5vw, 64px); column-gap: clamp(24px, 3vw, 40px); }
  .serve { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.5rem 3rem; scroll-margin-top: 96px; }
  .serve h2 { margin-bottom: 0.35em; }
  .serve p { margin: 0; color: var(--text-2); font-size: var(--step-1); line-height: 1.6; max-width: 40rem; }
</style>
