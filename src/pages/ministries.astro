---
import Base from '../layouts/Base.astro';
import MinistryCard from '../components/MinistryCard.astro';
import { ministries } from '../lib/content';

const sections = [
  { id: 'kids', title: 'Kids and teens', lead: 'Sunday school, AWANA, the kids choir and teens.' },
  { id: 'adults', title: 'Groups and adults', lead: 'Life Groups, young adults and missions.' },
  { id: 'schools', title: 'Schools', lead: 'Investing in the next generation.' },
  { id: 'serve', title: 'Serve', lead: 'Use your gifts to serve the church.' },
] as const;
// A section shows only when it has a card (cards whose text is still a placeholder are left out).
const visible = sections.map((s) => ({ ...s, items: ministries.filter((m) => m.group === s.id) })).filter((s) => s.items.length > 0);
---
<Base title="Ministries" description="Ministries at Spring of Life Church: AWANA, kids choir, teens, Life Groups, young adults, SOL Music Academy, SOL Russian School and more.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Ministries</span>
      <h1>Grow with us</h1>
      <p class="lead">From AWANA on Wednesday nights to Life Groups during the week, here's what happens at Spring of Life beyond Sunday. Registration for each program is on Church Center, and every button below points to this year's signup.</p>
      <nav class="jump" aria-label="Ministry sections">
        {visible.map((s) => <a class="chip" href={`#${s.id}`}>{s.title}</a>)}
      </nav>
    </div>
  </section>

  {visible.map((s, i) => (
    <section class:list={['section', 'section--tight', { 'section--soft': i % 2 === 1 }]} id={s.id} aria-labelledby={`${s.id}-title`}>
      <div class="wrap">
        <div class="section-head"><div><h2 id={`${s.id}-title`}>{s.title}</h2><p class="muted">{s.lead}</p></div></div>
        <div class="grid grid--3">
          {s.items.map((m) => <MinistryCard item={m} />)}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .jump .chip { padding: 0.5rem 0.95rem; font-size: 0.92rem; text-decoration: none; }
  .jump .chip:hover { border-color: var(--text); }
  section[id] { scroll-margin-top: 72px; }
  .section-head p { margin: 0.4rem 0 0; }
</style>
