---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GiveEmbed from '../components/GiveEmbed.astro';
import { site } from '../lib/content';

const page = await getEntry('pages', 'give');
if (!page) throw new Error('src/content/pages/give.md is missing');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Give</span>
      <h1>Give online</h1>
      <p class="lead">{page.data.intro}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap give">
      <GiveEmbed />
      <aside class="give-side">
        <div class="card side">
          <h2 class="h3">Prefer a full page?</h2>
          <p class="muted">Open our secure giving page on Subsplash. You can give once or set up a recurring gift.</p>
          <a class="btn btn--primary" href={site.links.give} target="_blank" rel="noopener">Open the giving page <Icon name="external" /></a>
        </div>
        <div class="card side prose" id="other-ways"><Content /></div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .give { display: grid; gap: 24px; }
  @media (min-width: 1024px) { .give { grid-template-columns: 1.4fr 1fr; align-items: start; } }
  .give-side { display: grid; gap: 16px; }
  .side { padding: clamp(20px, 3vw, 30px); }
  .h3 { font-size: var(--step-2); }
  .prose :global(h2) { font-size: var(--step-1); margin-top: 0; }
</style>
