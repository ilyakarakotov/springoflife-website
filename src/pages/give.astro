---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LinkText from '../components/LinkText.astro';
import GiveEmbed from '../components/GiveEmbed.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../lib/content';

const page = await getEntry('pages', 'give');
if (!page) throw new Error('src/content/pages/give.md is missing');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <PageHero eyebrow="Give" title="Why we give" lead={page.data.intro} />

  <section class="section section--tight">
    <div class="wrap give">
      <GiveEmbed />
      <aside class="give-side">
        <div class="side" data-reveal>
          <h2 class="card-title">Prefer the full giving page?</h2>
          <p>Give once or set up a recurring gift by card or bank account, and choose a fund such as tithe, missions or the Academy.</p>
          <a class="text-link" href={site.links.give} target="_blank" rel="noopener"><LinkText text="Open the giving page" icon="external" /></a>
        </div>
        <div class="side prose" id="other-ways" data-reveal><Content /></div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .give { display: grid; gap: clamp(36px, 4vw, 56px); }
  @media (min-width: 1024px) { .give { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: start; } }
  .give-side { display: grid; gap: clamp(28px, 3vw, 40px); }
  /* The side: short sections on hairlines, not boxes. */
  .side { padding-top: clamp(20px, 2.2vw, 26px); border-top: 1px solid var(--rule); scroll-margin-top: 96px; }
  .side .card-title { font-size: var(--step-2); letter-spacing: -0.02em; }
  .side > p { color: var(--text-2); margin: 0.6rem 0 1rem; }
  .prose :global(h2) { font-size: var(--step-2); letter-spacing: -0.02em; margin-top: 0; }
</style>
