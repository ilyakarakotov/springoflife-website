---
import { Image, Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LinkText from '../components/LinkText.astro';
import Happening from '../components/Happening.astro';
import SermonEmbed from '../components/SermonEmbed.astro';
import StepIcon from '../components/StepIcon.astro';
import MinistryCard from '../components/MinistryCard.astro';
import MoreLink from '../components/MoreLink.astro';
import ClosingInvite from '../components/ClosingInvite.astro';
import { site, home, img, events, groups, steps, ministries, external } from '../lib/content';
import { groupSummary, joinList } from '../lib/groups.mjs';
import { churchJsonLd } from '../lib/jsonld';
import { href } from '../lib/url';
import { lqip } from '../lib/lqip';

const homeSteps = steps.filter((s) => s.home).slice(0, 4);
const schools = ministries.filter((m) => m.group === 'schools');
const lg = groupSummary(groups);
// The mission (site.yaml) is the page's one quiet serif line: its first sentence large, the rest under it.
const [missionLead, ...missionRest] = site.mission.split(/(?<=\.)\s+/);

// The hero and quick-card photos are decorative (alt=""): the headline and card labels carry the
// meaning, and a failed download shows no broken-image icon or alt text over the preview.
// image_alt in home.yaml still describes the hero photo for social previews (Base.astro).
// Hero photo: preloaded (same AVIF srcset and sizes as the <picture>, so the browser reuses it) and
// drawn over a blurred inline preview, so a slow or failed download never leaves an empty dark block.
const heroImage = img(home.hero.image);
const HERO_WIDTHS = [640, 960, 1440, 2000];
// From 960 px the photo is drawn 135% wide, anchored to the bottom right (see .hero-photo below).
const HERO_SIZES = '(min-width: 960px) 135vw, 100vw';
const heroAvif = await getImage({ src: heroImage, widths: HERO_WIDTHS, width: 2000, format: 'avif' });
const heroPreview = await lqip(home.hero.image);
const quickPreviews = await Promise.all(home.quick_links.map((q) => lqip(q.image)));
// The quick-card photos load at low priority: they already show a preview, and when Chrome boosted
// the ones peeking into a phone's first screen they competed with the hero photo (LCP).
---
<Base overlayHeader jsonLd={churchJsonLd()}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroAvif.srcSet.attribute} imagesizes={HERO_SIZES} fetchpriority="high" />

  <section class="hero on-photo" aria-labelledby="hero-title" data-hero>
    <div class="hero-photo">
      <img class="lqip hero-preview" {...heroPreview} alt="" aria-hidden="true" />
      <Picture src={heroImage} alt="" widths={HERO_WIDTHS} width={2000} sizes={HERO_SIZES}
        formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="hero-img" pictureAttributes={{ class: 'hero-media' }} />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <p class="hero-eyebrow eyebrow--wave">{site.name} · {site.address.city}</p>
      <h1 id="hero-title" class="settle">{home.hero.headline}</h1>
      <p class="hero-when"><span>English service</span> · {site.service.day}s at {site.service.time}</p>
      <p class="hero-where">
        {site.address.street}, {site.address.city}
        <a href={site.address.maps_url} target="_blank" rel="noopener">Get directions<Icon name="external" /></a>
      </p>
      <div class="btn-row hero-actions">
        <a class="btn btn--primary" href={href('/visit')}>Plan a visit<Icon name="arrow" /></a>
        <a class="btn btn--ghost-light" href={href('/watch')}><Icon name="play" />Watch live or catch up</a>
      </div>
    </div>
  </section>

  <nav class="wrap quick" aria-label="Quick links">
    <ul>
      {home.quick_links.map((q, i) => (
        <li>
          <a class="quick-card on-photo" href={href(q.url)}>
            <img class="lqip" {...quickPreviews[i]} alt="" aria-hidden="true" />
            <Image src={img(q.image)} alt="" widths={[360, 600]} width={600} sizes="(min-width: 960px) 25vw, (min-width: 640px) 44vw, 72vw" fetchpriority="low" class={`focus-${q.image_focus}`} />
            <span class="quick-text">
              {q.kicker && <span class="quick-kicker">{q.kicker}</span>}
              <span class="quick-label">{q.title}</span>
            </span>
            <span class="quick-arrow arrow-circle arrow-circle--photo" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="section sunday-section" aria-labelledby="sunday-title">
    <div class="wrap sunday">
      <div class="sunday-main">
        <span class="eyebrow eyebrow--accent eyebrow--wave" data-reveal>Every {site.service.day}</span>
        <h2 id="sunday-title" data-reveal="lines">{home.sunday.title}</h2>
        <div class="times" data-reveal>
          <div class="time">
            <span class="time-label">English service</span>
            <b class="time-value tabular">{site.service.time}</b>
            <span class="meta">{site.service.length}</span>
          </div>
          <div class="time time--ru">
            <span class="time-label">Russian service</span>
            <b class="time-value time-value--sm tabular">{site.service.russian_time}</b>
            <a class="text-link" href={site.links.russian_site} target="_blank" rel="noopener" hreflang="ru"><LinkText text="Русский сайт" icon="external" lang="ru" /></a>
          </div>
        </div>
      </div>
      <div class="sunday-side" data-reveal>
        <h3 class="card-title">What to expect</h3>
        <ul class="expect">{home.sunday.points.map((p) => <li>{p}</li>)}</ul>
        <div class="sunday-place">
          <Icon name="pin" />
          <span><b>{site.address.street}</b><span class="meta">{site.address.city}, {site.address.region} {site.address.postal_code}</span></span>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={href('/visit')}>Plan a visit<Icon name="arrow" /></a>
          <a class="text-link" href={site.address.maps_url} target="_blank" rel="noopener"><LinkText text="Get directions" icon="external" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section mission" aria-labelledby="mission-title">
    <div class="wrap mission-inner">
      <span class="eyebrow eyebrow--accent eyebrow--wave" data-reveal>Our mission</span>
      <h2 id="mission-title" class="scripture" data-reveal>{missionLead}</h2>
      {missionRest.length > 0 && <p class="mission-rest" data-reveal>{missionRest.join(' ')}</p>}
      <p class="mission-more" data-reveal><a class="text-link" href={href('/about')}><LinkText text="About us" icon="arrow" /></a></p>
    </div>
  </section>

  <Happening events={events} />

  <section class="section" aria-labelledby="sermon-title">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Latest sermon</span><h2 id="sermon-title" data-reveal="lines">Faith comes from hearing</h2></div>
        <MoreLink to={site.links.sermons} label="All sermons" />
      </div>
      <div class="sermon">
        <figure class="sermon-player">
          <div data-reveal="photo"><SermonEmbed /></div>
          <figcaption class="meta">Sunday's message is posted here once it's ready.</figcaption>
        </figure>
        <div class="sermon-side" data-reveal>
          <span class="eyebrow eyebrow--accent">Live on {site.service.day}s</span>
          <h3>Watch live at {site.service.time}</h3>
          <p>The English service streams live on YouTube.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={site.links.youtube_live} target="_blank" rel="noopener"><Icon name="youtube" />Watch live</a>
          </div>
          <ul class="sermon-links">
            <li><a class="text-link" href={href('/watch')}><LinkText text="Sermons and live stream" icon="arrow" /></a></li>
            <li><a class="text-link" href={site.links.bulletin} target="_blank" rel="noopener"><LinkText text="This week's bulletin" icon="external" /></a></li>
          </ul>
        </div>
      </div>
      <p class="section-foot"><MoreLink to={site.links.sermons} label="All sermons" /></p>
    </div>
  </section>

  {groups.length > 0 && (
    <section class="section section--tint groups-band" aria-labelledby="groups-title">
      <div class="wrap groups-grid">
        <div>
          <span class="eyebrow eyebrow--accent eyebrow--wave" data-reveal>{home.groups.eyebrow}</span>
          <h2 id="groups-title" data-reveal="lines">{home.groups.title}</h2>
          <p class="lead" data-reveal>{home.groups.text}</p>
          <div class="btn-row" data-reveal><a class="btn btn--primary" href={href('/life-groups')}>Find a Life Group<Icon name="arrow" /></a></div>
        </div>
        <dl class="groups-facts" data-reveal>
          <div><dt>Groups</dt><dd>{lg.count} English Life Groups</dd></div>
          {lg.days.length > 0 && <div><dt>When</dt><dd>{joinList(lg.days)}</dd></div>}
          {lg.places.length > 0 && <div><dt>Where</dt><dd>{joinList(lg.places)}</dd></div>}
        </dl>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="steps-title" data-reveal="lines">Take your next step</h2>
        <MoreLink to="/next-steps" label="See every next step" />
      </div>
      <ul class="steps">
        {homeSteps.map((s) => (
          <li data-reveal>
            <a class="step" href={href(s.url)} {...external(s.url)}>
              <span class="icon-tile"><StepIcon id={s.id} /></span>
              <span class="step-text"><b>{s.title}</b><span>{s.text}</span></span>
              <span class="step-cta"><LinkText text={s.cta} icon={s.url.startsWith('/') ? 'arrow' : 'external'} /></span>
              <span class="step-arrow arrow-circle arrow-circle--sm" aria-hidden="true"><Icon name={s.url.startsWith('/') ? 'arrow' : 'external'} /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="section-foot"><MoreLink to="/next-steps" label="See every next step" /></p>
    </div>
  </section>

  {schools.length > 0 && (
    <section class="section section--soft" aria-labelledby="schools-title">
      <div class="wrap">
        <div class="section-head">
          <div><span class="eyebrow">Schools</span><h2 id="schools-title" data-reveal="lines">Investing in the next generation</h2>
            <p class="lead" data-reveal>Christian education, music lessons and Russian-language classes at the church.</p></div>
        </div>
        <div class="grid grid--3 schools">{schools.map((m) => <MinistryCard item={m} compact />)}</div>
      </div>
    </section>
  )}

  <section class="section" aria-label="Give and the church app">
    <div class="wrap give-app">
      <div class="give-col" data-reveal>
        <h2>{home.give.title}</h2>
        <p>{home.give.text}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={href('/give')}>Give online<Icon name="arrow" /></a>
          <a class="text-link" href={href('/give#other-ways')}><LinkText text="Other ways to give" icon="arrow" /></a>
        </div>
      </div>
      <div class="app-col" data-reveal>
        <h2>{home.app.title}</h2>
        <p>{home.app.text}</p>
        <div class="btn-row">
          <a class="btn btn--outline" href={site.links.app_ios} target="_blank" rel="noopener"><Icon name="smartphone" />App Store</a>
          <a class="btn btn--outline" href={site.links.app_android} target="_blank" rel="noopener"><Icon name="smartphone" />Google Play</a>
        </div>
      </div>
    </div>
  </section>

  <ClosingInvite image="/src/assets/photos/arrival.jpg" crop="upper" />
</Base>

<style>
  /* ---- Hero ----
     Stacking is explicit and positive: the photo layer (0: blurred preview, then the photo) < scrim
     (1) < text (2). Nothing depends on negative z-index or isolation, so an extension or a
     forced-dark engine that paints a background on the content can't hide the photo. If the photo
     fails, the preview and then the designed gradient show, and no alt text appears.
     Motion (motion.css): the photo settles on load and lags and dims as the hero leaves; the
     headline settles. Both are painted on the first frame. */
  .hero { position: relative; min-height: min(94svh, 880px); display: flex; align-items: flex-end; overflow: hidden; color: #fff;
    background: var(--hero-fallback) linear-gradient(160deg, #1d2740 0%, #0b0d12 70%); }
  .hero-photo { position: absolute; inset: 0; z-index: 0; }
  .hero-photo > .hero-preview, .hero-photo > :global(.hero-media) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .hero :global(.hero-img), .hero-photo > .hero-preview { width: 100%; height: 100%; object-fit: cover; object-position: 62% 40%; }
  .hero :global(.hero-img) { color: transparent; }
  /* Phones: text sits low over a dark bottom. */
  .hero-scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgb(5 8 15 / 0.5) 0, rgb(5 8 15 / 0.1) 22%, rgb(5 8 15 / 0.3) 45%, rgb(5 8 15 / 0.82) 78%, rgb(5 8 15 / 0.9) 100%); }
  @media (min-width: 960px) {
    /* Wide screens: the photo is drawn larger and anchored bottom-right, so the projected lyrics move
       up under the header fade and the raised hand clears the headline. The scrim is side-weighted:
       dark behind the text, the photo vivid on the right. */
    .hero-photo { inset: auto 0 0 auto; width: 135%; height: 135%; transform-origin: 76% 76%; }
    .hero :global(.hero-img), .hero-photo > .hero-preview { object-position: 100% 100%; }
    .hero-scrim { background:
      linear-gradient(90deg, rgb(5 8 15 / 0.8) 0%, rgb(5 8 15 / 0.52) 34%, rgb(5 8 15 / 0.08) 62%, rgb(5 8 15 / 0) 80%),
      linear-gradient(180deg, rgb(5 8 15 / 0.55) 0, rgb(5 8 15 / 0) 160px),
      linear-gradient(0deg, rgb(5 8 15 / 0.62) 0, rgb(5 8 15 / 0) 40%); }
  }
  @media (prefers-color-scheme: dark) { .hero { box-shadow: 0 1px 0 rgb(255 255 255 / 0.06); } }
  .hero-content { position: relative; z-index: 2; padding-top: 136px; padding-bottom: clamp(140px, 17vw, 210px); }
  .hero-eyebrow { margin: 0 0 1.1rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(255 255 255 / 0.88); }
  .hero h1 { font-size: var(--step-5); line-height: 0.98; letter-spacing: -0.05em; max-width: 11ch; margin: 0 0 0.32em; text-shadow: 0 2px 28px rgb(0 0 0 / 0.25); }
  .hero-when { margin: 0; font-size: var(--step-1); font-weight: 600; }
  .hero-when span { font-weight: 800; }
  .hero-where { display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.9rem; margin: 0.3rem 0 2rem; font-size: 1rem; color: rgb(255 255 255 / 0.88); }
  .hero-where a { display: inline-flex; align-items: center; gap: 0.3em; color: #fff; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgb(255 255 255 / 0.5); transition: text-decoration-color var(--dur-2) var(--ease); }
  .hero-where a:hover { text-decoration-color: #fff; }
  .hero-where :global(.icon) { transition: transform var(--dur-2) var(--ease); }
  @media (max-width: 639.98px) { .hero-actions { flex-direction: column; align-items: stretch; } }

  /* ---- Quick links ---- */
  .quick { position: relative; z-index: 3; margin-top: clamp(-156px, -13vw, -96px); }
  /* The scroller clips whatever paints outside it, so it gets 8px of room on every side (taken back
     with a negative margin; same layout): enough for the focus ring (outline + 7px dark band on
     photos), which was cut off on phones and tablets. */
  .quick ul { list-style: none; margin: -8px; padding: 8px 8px 12px; scroll-padding-inline: 8px; display: grid; grid-auto-flow: column; grid-auto-columns: 74%; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .quick ul::-webkit-scrollbar { display: none; }
  .quick li { scroll-snap-align: start; }
  @media (min-width: 640px) { .quick ul { grid-auto-columns: 44%; gap: 16px; } }
  @media (min-width: 960px) { .quick ul { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; gap: 20px; } }
  .quick-card { position: relative; display: block; aspect-ratio: 4 / 4.2; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; background: #1b2232; box-shadow: var(--shadow-2); }
  .quick-card :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; color: transparent; }
  .quick-card :global(img:not(.lqip)) { transition: scale 0.9s var(--ease); }
  .quick-card:hover :global(img:not(.lqip)) { scale: 1.04; }
  .quick-card :global(.focus-left) { object-position: 22% 50%; }
  .quick-card :global(.focus-right) { object-position: 88% 50%; }
  .quick-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(5 8 15 / 0) 36%, rgb(5 8 15 / 0.8) 100%); }
  .quick-text { position: absolute; z-index: 1; left: 20px; right: 72px; bottom: 20px; display: grid; gap: 0.2rem; text-wrap: balance; }
  .quick-kicker { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(255 255 255 / 0.84); }
  .quick-label { font-size: var(--step-1); font-weight: 700; line-height: 1.2; letter-spacing: -0.015em; }
  .quick-arrow { position: absolute; z-index: 1; right: 16px; bottom: 16px; }

  /* ---- Sunday: two editorial columns on a hairline, no box ---- */
  .sunday { display: grid; gap: clamp(40px, 5vw, 72px); }
  .sunday-main h2 { margin-bottom: clamp(24px, 3vw, 40px); }
  .sunday-side { display: grid; gap: 1.4rem; align-content: start; border-top: 1px solid var(--rule); padding-top: clamp(24px, 3vw, 32px); }
  @media (min-width: 900px) {
    .sunday { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .sunday-side { border-top: 0; padding-top: 0.4rem; border-left: 1px solid var(--rule); padding-left: clamp(32px, 4.5vw, 72px); }
  }
  /* Side by side when both fit, otherwise the Russian time wraps under the English one. A fixed
     two-column grid pushed "10:00 am" into the "What to expect" column from 900 px up. */
  .times { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.75rem clamp(32px, 5vw, 64px); }
  .time { display: grid; gap: 0.35rem; align-content: start; }
  .time-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .time-value { white-space: nowrap; font-size: clamp(3.25rem, 2.2rem + 3.6vw, 5.5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.92; }
  .time-value--sm { font-size: clamp(2rem, 1.6rem + 1.5vw, 2.75rem); color: var(--text-2); }
  .time .text-link { font-size: 0.9375rem; }
  .expect { list-style: none; margin: 0; padding: 0; color: var(--text-2); }
  .expect li { padding: 0.75rem 0 0.75rem 1.6rem; position: relative; border-top: 1px solid var(--border); }
  .expect li:last-child { border-bottom: 1px solid var(--border); }
  .expect li::before { content: ''; position: absolute; left: 2px; top: 1.36em; width: 8px; height: 8px; border-radius: 999px; border: 2px solid var(--accent-text); }
  .sunday-place { display: flex; gap: 0.75rem; align-items: flex-start; }
  .sunday-place :global(.icon) { width: 22px; height: 22px; color: var(--accent-text); margin-top: 2px; }
  .sunday-place > span { display: grid; }

  /* ---- Mission: the page's one quiet serif line ---- */
  .mission { padding-top: 0; } /* right after Sunday: one shared space, not two */
  .mission-inner { display: grid; justify-items: center; text-align: center; }
  .mission .eyebrow { margin-bottom: 1.25rem; }
  .mission h2 { font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem); max-width: 16ch; margin: 0 0 0.45em; }
  .mission-rest { max-width: 34rem; margin: 0 0 1.5rem; font-size: var(--step-1); line-height: 1.6; color: var(--text-2); }
  .mission-more { margin: 0; }

  /* ---- Sermon ---- */
  .sermon { display: grid; gap: clamp(28px, 3.5vw, 48px); }
  @media (min-width: 960px) { .sermon { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); align-items: start; } }
  .sermon-player { margin: 0; }
  .sermon-player figcaption { margin-top: 0.85rem; }
  .sermon-side h3 { margin: 0 0 0.45rem; font-size: var(--step-2); }
  .sermon-side p { color: var(--text-2); }
  .sermon-links { list-style: none; margin: 1.75rem 0 0; padding: 1.4rem 0 0; border-top: 1px solid var(--rule); display: grid; gap: 0.7rem; }
  @media (min-width: 960px) { .sermon-side { padding-top: 0.25rem; } }

  /* ---- Life Groups ---- */
  .groups-grid { display: grid; gap: clamp(36px, 5vw, 80px); }
  @media (min-width: 960px) { .groups-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; } }
  .groups-grid h2 { max-width: 18ch; }
  .groups-grid .lead { margin-bottom: 2rem; }
  .groups-facts { margin: 0; display: grid; border-top: 1px solid color-mix(in srgb, var(--accent-text) 30%, transparent); }
  .groups-facts div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid color-mix(in srgb, var(--accent-text) 18%, transparent); }
  .groups-facts dt { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); padding-top: 0.25rem; }
  .groups-facts dd { margin: 0; font-weight: 700; font-size: 1.125rem; letter-spacing: -0.01em; }

  /* ---- Next steps: columns on hairlines (wide), rows with an arrow ring (phones) ---- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .steps li { display: flex; }
  @media (min-width: 640px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 3vw, 40px) clamp(24px, 3vw, 40px); } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .step { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; gap: 16px; width: 100%; padding: 16px 0; border-top: 1px solid var(--rule); text-decoration: none; }
  .steps li:last-child .step { border-bottom: 1px solid var(--rule); }
  .step-text { display: grid; gap: 0.35rem; }
  .step-text b { font-size: 1.125rem; letter-spacing: -0.015em; }
  .step-text span, .step-cta { display: none; }
  .step:hover .step-text b { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1.5px; }
  @media (min-width: 640px) {
    .step { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: clamp(24px, 2.4vw, 30px) 0 0; }
    .steps li:last-child .step { border-bottom: 0; }
    .step-text b { font-size: var(--step-2); }
    .step-text span { display: block; color: var(--text-2); font-size: 0.97rem; }
