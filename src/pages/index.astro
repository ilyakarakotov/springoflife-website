---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EventCard from '../components/EventCard.astro';
import EventsEmpty from '../components/EventsEmpty.astro';
import SermonEmbed from '../components/SermonEmbed.astro';
import StepIcon from '../components/StepIcon.astro';
import MinistryCard from '../components/MinistryCard.astro';
import { site, home, img, events, groups, steps, ministries, forms, external } from '../lib/content';
import { churchJsonLd } from '../lib/jsonld';
import { href } from '../lib/url';

const nextEvents = events.slice(0, 3);
const homeSteps = steps.filter((s) => s.home).slice(0, 5);
const [featureStep, ...tileSteps] = [...homeSteps.filter((s) => s.image), ...homeSteps.filter((s) => !s.image)];
const schools = ministries.filter((m) => m.group === 'schools');
const tileStyles = ['tile--accent', 'tile--plain', 'tile--plain', 'tile--dark'];
---
<Base overlayHeader jsonLd={churchJsonLd()}>
  <section class="hero" aria-labelledby="hero-title">
    <Picture src={img(home.hero.image)} alt={home.hero.image_alt} widths={[640, 960, 1440, 2000]} width={2000} sizes="100vw"
      formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="hero-img" />
    <div class="wrap hero-content">
      <h1 id="hero-title">{home.hero.headline}</h1>
      <p class="hero-sub">{site.service.day}s at {site.service.time} · {site.address.city}, {site.address.region}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={href('/visit')}>Plan your visit</a>
        <a class="btn btn--ghost-light" href={href('/watch')}><Icon name="play" />Watch online</a>
      </div>
    </div>
  </section>

  <nav class="wrap quick" aria-label="Quick links">
    <ul>
      {home.quick_links.map((q) => (
        <li>
          <a class="quick-card" href={href(q.url)}>
            <Image src={img(q.image)} alt={q.image_alt} widths={[360, 600]} width={600} sizes="(min-width: 960px) 25vw, 70vw" />
            <span class="quick-label">{q.title}</span>
            <span class="quick-arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="section">
    <div class="wrap split">
      <div class="sunday">
        <h2>{home.sunday.title}</h2>
        <Image src={img(home.sunday.image)} alt={home.sunday.image_alt} widths={[480, 800, 1200]} width={1200} sizes="(min-width: 960px) 46vw, 100vw" class="sunday-img" />
        <div class="sunday-info">
          <div>
            <p class="big-time">{site.service.time.replace('pm', 'PM')}</p>
            <p class="muted">Every {site.service.day}</p>
          </div>
          <ul class="checklist">{home.sunday.points.map((p) => <li><Icon name="check" /><span>{p}</span></li>)}</ul>
        </div>
        <div class="btn-row">
          <a class="btn btn--dark" href={href('/visit')}>Plan your visit</a>
          <a class="btn btn--outline" href={site.address.maps_url} target="_blank" rel="noopener">Get directions</a>
          <span class="muted address">{site.address.street}, {site.address.city}</span>
        </div>
      </div>
      <div class="together">
        <h2>Do life together.</h2>
        <div class="together-card">
          <span class="eyebrow">{home.groups.eyebrow}</span>
          <h3>{home.groups.title}</h3>
          <p class="muted">{home.groups.text}</p>
          <div class="stats">
            <div class="stat"><b>{groups.length}</b><span>English Life Groups</span></div>
            <div class="stat"><b>{nextEvents.length || 'All'}</b><span>{nextEvents.length ? (nextEvents.length === 1 ? 'Upcoming event' : 'Upcoming events') : 'Signups on Church Center'}</span></div>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary" href={href('/life-groups')}>Find a group</a>
            <a class="btn btn--outline" href={forms.serve} target="_blank" rel="noopener">Join a serving team</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="sermon-title">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Latest sermon</span><h2 id="sermon-title">Hear God's Word</h2></div>
        <a class="btn btn--outline" href={site.links.sermons} target="_blank" rel="noopener">All sermons</a>
      </div>
      <div class="sermon">
        <SermonEmbed />
        <div class="sermon-side card">
          <p class="muted">New sermons are posted here every week after Sunday's service.</p>
          <h3>Watch live on Sundays at {site.service.time}</h3>
          <p class="muted">The English service streams live on YouTube.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={site.links.youtube_live} target="_blank" rel="noopener"><Icon name="youtube" />Watch live</a>
            <a class="btn btn--outline" href={href('/watch')}>More to watch</a>
          </div>
          <a class="text-link bulletin" href={site.links.bulletin} target="_blank" rel="noopener">This week's bulletin <Icon name="external" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="events-title">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Events</span><h2 id="events-title">What's happening</h2></div>
        <a class="btn btn--outline" href={href('/events')}>See all events</a>
      </div>
      {nextEvents.length === 0 && <EventsEmpty />}
      {nextEvents.length === 1 && <EventCard event={nextEvents[0]} layout="wide" />}
      {nextEvents.length > 1 && <div class="grid grid--3">{nextEvents.map((e) => <EventCard event={e} />)}</div>}
      <p class="notice"><Icon name="refresh" />Updates automatically from Planning Center.</p>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head section-head--center">
        <div><span class="eyebrow">Get involved</span><h2 id="steps-title">Find your next step</h2></div>
      </div>
      <div class="tiles">
        {featureStep && (
          <a class="tile tile--photo" href={href(featureStep.url)} {...external(featureStep.url)}>
            {featureStep.image && <Image src={img(featureStep.image)} alt="" widths={[480, 800]} width={800} sizes="(min-width: 960px) 36vw, 100vw" />}
            <span class="tile-text"><b>{featureStep.title}</b><span>{featureStep.text}</span></span>
          </a>
        )}
        {tileSteps.map((s, i) => (
          <a class:list={['tile', tileStyles[i % tileStyles.length]]} href={href(s.url)} {...external(s.url)}>
            <StepIcon id={s.id} />
            <span class="tile-text"><b>{s.title}</b><span>{s.text}</span></span>
          </a>
        ))}
      </div>
      <p class="center"><a class="text-link" href={href('/next-steps')}>All next steps <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="schools-title">
    <div class="wrap schools">
      <div><span class="eyebrow">Schools</span><h2 id="schools-title">Investing in the next generation</h2></div>
      <div class="grid grid--3">{schools.map((m) => <MinistryCard item={m} compact />)}</div>
    </div>
  </section>

  <section class="section section--tight" aria-label="Give and app">
    <div class="wrap give-app">
      <div class="give-card">
        <Image src={img('/src/assets/photos/sanctuary-back.jpg')} alt="" widths={[600, 900]} width={900} sizes="(min-width: 960px) 46vw, 100vw" />
        <div class="give-text">
          <h2>{home.give.title}</h2>
          <p>{home.give.text}</p>
          <div class="btn-row"><a class="btn btn--light" href={href('/give')}>Give online</a><a class="btn btn--ghost-light" href={href('/give#other-ways')}>Other ways to give</a></div>
        </div>
      </div>
      <div class="app-card">
        <h2>{home.app.title}</h2>
        <p>{home.app.text}</p>
        <div class="btn-row">
          <a class="btn btn--ghost-light" href={site.links.app_ios} target="_blank" rel="noopener">App Store</a>
          <a class="btn btn--ghost-light" href={site.links.app_android} target="_blank" rel="noopener">Google Play</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: min(92svh, 860px); display: flex; align-items: flex-end; color: #fff; background: #0b0d12; isolation: isolate; }
  .hero :global(.hero-img) { position: absolute; inset: 0; z-index: -2; }
  .hero :global(.hero-img img), .hero :global(img.hero-img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(5 8 15 / 0.55) 0%, rgb(5 8 15 / 0.15) 32%, rgb(5 8 15 / 0.35) 60%, rgb(5 8 15 / 0.82) 100%); }
  .hero-content { padding-top: 140px; padding-bottom: clamp(150px, 20vw, 210px); }
  .hero h1 { max-width: 12ch; margin-bottom: 0.25em; text-shadow: 0 2px 30px rgb(0 0 0 / 0.25); }
  .hero-sub { font-size: var(--step-1); font-weight: 500; margin-bottom: 1.6rem; opacity: 0.95; }
  @media (max-width: 639.98px) { .hero .btn-row { flex-direction: column; align-items: stretch; } .hero-content { padding-bottom: 120px; } }

  .quick { position: relative; z-index: 2; margin-top: clamp(-150px, -14vw, -96px); }
  .quick ul { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 72%; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
  .quick ul::-webkit-scrollbar { display: none; }
  .quick li { scroll-snap-align: start; }
  @media (min-width: 640px) { .quick ul { grid-auto-columns: 44%; } }
  @media (min-width: 960px) { .quick ul { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; gap: 20px; } }
  .quick-card { position: relative; display: block; aspect-ratio: 1 / 0.95; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; background: #111; box-shadow: var(--shadow); }
  .quick-card :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .quick-card:hover :global(img) { transform: scale(1.04); }
  .quick-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0) 35%, rgb(0 0 0 / 0.72) 100%); }
  .quick-label { position: absolute; z-index: 1; left: 22px; right: 70px; bottom: 20px; font-size: var(--step-1); font-weight: 800; line-height: 1.2; letter-spacing: -0.01em; }
  .quick-arrow { position: absolute; z-index: 1; right: 18px; bottom: 18px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 999px; background: #fff; color: #111; }

  .split { display: grid; gap: clamp(40px, 6vw, 64px); }
  @media (min-width: 960px) { .split { grid-template-columns: 1fr 1fr; } }
  .sunday :global(.sunday-img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius); margin-bottom: 1.5rem; }
  .sunday-info { display: grid; gap: 1rem 2rem; margin-bottom: 1.5rem; }
  @media (min-width: 560px) { .sunday-info { grid-template-columns: auto 1fr; } }
  .big-time { font-size: clamp(2rem, 1.5rem + 2vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin: 0 0 0.35rem; }
  .sunday-info .muted { margin: 0; }
  .address { font-size: 0.9rem; }
  .together-card { background: var(--bg-tint); border-radius: var(--radius); padding: clamp(24px, 4vw, 44px); }
  .together-card h3 { font-size: var(--step-2); }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 1.75rem 0; }
  .stat { background: var(--surface); border-radius: 16px; padding: 18px 20px; display: grid; gap: 0.25rem; }
  .stat b { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .stat span { font-size: 0.9rem; color: var(--muted); }

  .sermon { display: grid; gap: 20px; }
  @media (min-width: 960px) { .sermon { grid-template-columns: 1.6fr 1fr; align-items: stretch; } }
  .sermon-side { padding: clamp(22px, 3vw, 36px); display: flex; flex-direction: column; gap: 0.5rem; }
  .sermon-side h3 { font-size: var(--step-2); margin: 0.25rem 0 0; }
  .sermon-side .btn-row { margin-top: 0.75rem; }
  .bulletin { margin-top: auto; padding-top: 1rem; }

  .tiles { display: grid; gap: 16px; }
  @media (min-width: 720px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .tiles { grid-template-columns: 1.2fr 1fr 1fr; grid-template-rows: repeat(2, minmax(240px, auto)); } .tile--photo { grid-row: span 2; } }
  .tile { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 2.5rem; min-height: 220px; padding: clamp(22px, 3vw, 34px); border-radius: var(--radius); text-decoration: none; overflow: hidden; transition: transform 0.2s; }
  .tile:hover { transform: translateY(-3px); }
  .tile-text { display: grid; gap: 0.4rem; position: relative; }
  .tile-text b { font-size: var(--step-2); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; }
  .tile-text span { font-size: 0.97rem; opacity: 0.92; }
  .tile :global(.step-icon) { width: 32px; height: 32px; }
  .tile--accent { background: var(--accent); color: #fff; }
  .tile--plain { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
  .tile--plain :global(.step-icon) { color: var(--accent-text); }
  .tile--dark { background: var(--dark); color: var(--on-dark); }
  .tile--photo { color: #fff; justify-content: flex-end; min-height: 380px; background: #111; }
  .tile--photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tile--photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0.05) 30%, rgb(0 0 0 / 0.75)); }
  .tile--photo .tile-text { z-index: 1; }
  .center { text-align: center; margin: 1.75rem 0 0; }

  .schools { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 1024px) { .schools { grid-template-columns: 0.8fr 2fr; } }

  .give-app { display: grid; gap: 20px; }
  @media (min-width: 960px) { .give-app { grid-template-columns: 1fr 1fr; } }
  .give-card, .app-card { position: relative; border-radius: var(--radius); overflow: hidden; color: #fff; padding: clamp(28px, 4.5vw, 52px); min-height: 340px; display: flex; flex-direction: column; justify-content: center; }
  .give-card :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .give-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(8 10 16 / 0.86), rgb(8 10 16 / 0.55)); }
  .give-text { position: relative; z-index: 1; max-width: 30rem; }
  .give-card p, .app-card p { opacity: 0.9; }
  .app-card { background: var(--dark-2); border: 1px solid rgb(255 255 255 / 0.06); }
</style>
