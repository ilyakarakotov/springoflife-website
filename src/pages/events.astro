---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LinkText from '../components/LinkText.astro';
import EventRow from '../components/EventRow.astro';
import EveryWeek from '../components/EveryWeek.astro';
import PageHero from '../components/PageHero.astro';
import ClosingInvite from '../components/ClosingInvite.astro';
import { site, events } from '../lib/content';
import { byMonth } from '../lib/event-display';
import { href } from '../lib/url';

const months = byMonth(events);
---
<Base title="Events" description="Upcoming events at Spring of Life Church in Mukilteo, WA. Register on Church Center.">
  <PageHero eyebrow="Events" title="Coming up at Spring of Life"
    lead="Upcoming events at Spring of Life Church. Registration and payment happen on Church Center, our Planning Center site.">
    <div class="btn-row">
      <a class="text-link" href={href('/events.ics')}><Icon name="calendar" class="lead" />Add to your calendar</a>
      <a class="text-link" href={site.links.signups} target="_blank" rel="noopener"><LinkText text="All signups on Church Center" icon="external" /></a>
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap events-layout">
      <div class="events-list" data-events-count={events.length}>
        {events.length === 0 ? (
          <div class="events-empty" data-reveal>
            <h2>Nothing on the calendar right now</h2>
            <p>Check back soon, or see every open signup on Church Center.</p>
            <a class="text-link" href={site.links.signups} target="_blank" rel="noopener"><LinkText text="All signups on Church Center" icon="external" /></a>
          </div>
        ) : months.map((m, i) => (
          <section class="month" aria-labelledby={`month-${i}`}>
            <h2 class="month-title" id={`month-${i}`}>{m.label}</h2>
            <ul class="event-rows">{m.events.map((e, j) => <EventRow event={e} headingLevel="h3" thumb="lg" eager={i === 0 && j === 0} />)}</ul>
          </section>
        ))}
      </div>
      <EveryWeek headingLevel="h2" />
    </div>
  </section>

  <ClosingInvite />
</Base>

<style>
  .events-layout { display: grid; gap: clamp(40px, 5vw, 72px); }
  @media (min-width: 1024px) { .events-layout { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: start; } }
  .month + .month { margin-top: clamp(28px, 4vw, 44px); }
  .month-title { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0; padding-bottom: 0.9rem; border-bottom: 1px solid var(--text); }
  .event-rows { list-style: none; margin: 0; padding: 0; }
  .events-empty { padding: clamp(28px, 4vw, 44px) 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .events-empty h2 { font-size: var(--step-2); margin-bottom: 0.4rem; }
  .events-empty p { color: var(--text-2); }
</style>
