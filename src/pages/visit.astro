---
// Plan a visit: the most important page for a first-time guest. Who, when and where up top, what
// a Sunday is like, kids, getting here, the Russian service and how to reach us. Text lives in
// src/content/visit.yaml; times and the address come from site.yaml.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LinkText from '../components/LinkText.astro';
import ClosingInvite from '../components/ClosingInvite.astro';
import { site, img, visit, forms } from '../lib/content';
import { href } from '../lib/url';
import { lqip } from '../lib/lqip';

const photo = img(visit.image);
const preview = await lqip(visit.image);
const tel = site.phone.replace(/[^\d+]/g, '');
---
<Base title={visit.title} description={visit.description} image={photo} imageAlt={visit.image_alt}>
  <section class="page-hero visit-hero">
    <div class="wrap visit-hero-grid">
      <div class="visit-hero-text">
        <span class="eyebrow eyebrow--accent eyebrow--wave">Plan a visit</span>
        <h1 class="settle">{visit.heading}</h1>
        <p class="lead">{visit.intro}</p>
        <ul class="visit-facts">
          <li><Icon name="clock" /><span><b>{site.service.day}s at {site.service.time}</b><span class="meta">English service · {site.service.length.toLowerCase()}</span></span></li>
          <li><Icon name="pin" /><span><b>{site.address.street}</b><span class="meta">{site.address.city}, {site.address.region} {site.address.postal_code}</span></span></li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.address.maps_url} target="_blank" rel="noopener"><Icon name="pin" />Get directions</a>
          <a class="text-link" href={forms.connect} target="_blank" rel="noopener"><LinkText text="Fill out a connect card" icon="external" /></a>
        </div>
      </div>
      <figure class="visit-photo">
        <img class="lqip" {...preview} alt="" aria-hidden="true" />
        <Picture src={photo} alt={visit.image_alt} widths={[560, 800, 1120, 1600]} sizes="(min-width: 1400px) 600px, (min-width: 960px) 44vw, 100vw"
          formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="visit-img" />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="expect-title">
    <div class="wrap">
      <div class="section-head"><h2 id="expect-title" data-reveal="lines">What to expect</h2></div>
      <ul class="expect-grid">
        {visit.expect.map((x) => (
          <li class="expect-item" data-reveal>
            <span class="icon-tile"><Icon name={x.icon} /></span>
            <h3 class="card-title">{x.title}</h3>
            <p>{x.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--soft" aria-label="Kids and arriving on Sunday">
    <div class="wrap duo">
      <article class="duo-item" id="kids" data-reveal>
        <span class="icon-tile"><Icon name="kids" /></span>
        <h2>Kids</h2>
        <p>{visit.kids}</p>
        <a class="text-link" href={href('/ministries#kids')}><LinkText text="Kids and teens ministries" icon="arrow" /></a>
      </article>
      <article class="duo-item" id="arrive" data-reveal>
        <span class="icon-tile"><Icon name="coffee" /></span>
        <h2>When you arrive</h2>
        <p>{visit.arrival}</p>
        <a class="text-link" href={site.address.maps_url} target="_blank" rel="noopener"><LinkText text={`Directions to ${site.address.street}`} icon="external" /></a>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="here-title">
    <div class="wrap">
      <div class="section-head"><h2 id="here-title" data-reveal="lines">Getting here</h2></div>
      <div class="here">
        <div class="here-item" data-reveal>
          <span class="eyebrow">Address</span>
          <p class="address">{site.name}<br />{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal_code}</p>
          <a class="btn btn--outline" href={site.address.maps_url} target="_blank" rel="noopener">Open in Google Maps<Icon name="external" /></a>
        </div>
        <div class="here-item" data-reveal>
          <span class="eyebrow">Russian service</span>
          <p class="here-big tabular">{site.service.day}s at {site.service.russian_time}</p>
          <p>Spring of Life also worships in Russian every {site.service.day} morning, before the English service.</p>
          <a class="text-link" href={site.links.russian_site} target="_blank" rel="noopener" hreflang="ru"><LinkText text="Русский сайт" icon="external" lang="ru" /></a>
        </div>
        <div class="here-item" id="contact" data-reveal>
          <span class="eyebrow">Contact us</span>
          <ul class="contact">
            <li><Icon name="phone" /><a href={`tel:${tel}`}>{site.phone}</a></li>
            <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><Icon name="card" /><a href={forms.connect} target="_blank" rel="noopener">Fill out a connect card</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* The closing band asks the page's one question (the hero photo is the entrance, so this one is the sanctuary). */}
  <ClosingInvite title="New here, or have a question?" text="Tell us a little about yourself on a connect card." cta="Fill out a connect card" url={forms.connect} />
</Base>

<style>
  .visit-hero-grid { display: grid; gap: clamp(32px, 4.5vw, 72px); align-items: center; }
  @media (min-width: 960px) { .visit-hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); } }
  .visit-hero h1 { max-width: 11ch; margin-bottom: 0.4em; }
  /* When and where: two facts on a hairline, no boxes. */
  .visit-facts { list-style: none; margin: 2rem 0; padding: 0; display: grid; border-top: 1px solid var(--rule); }
  @media (min-width: 560px) { .visit-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; } }
  .visit-facts li { display: flex; gap: 0.75rem; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--rule); }
  .visit-facts :global(.icon) { width: 22px; height: 22px; margin-top: 2px; color: var(--accent-text); }
  .visit-facts li > span { display: grid; }
  .visit-hero .btn-row { margin-top: 0; }
  .visit-photo { position: relative; margin: 0; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius); background: var(--surface-soft); box-shadow: var(--shadow-2); }
  @media (min-width: 960px) { .visit-photo { aspect-ratio: 4 / 4.2; } }
  .visit-photo > .lqip, .visit-photo :global(picture), .visit-photo :global(.visit-img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The file is cropped below the old sign line; the top edge stays put (object-position 50% 0). */
  .visit-photo > .lqip, .visit-photo :global(.visit-img) { object-fit: cover; object-position: 50% 0; }

  /* What to expect: four columns on hairlines. */
  .expect-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(28px, 3vw, 40px) clamp(24px, 3vw, 40px); }
  @media (min-width: 640px) { .expect-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .expect-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .expect-item { display: grid; gap: 0.7rem; align-content: start; padding-top: clamp(22px, 2.4vw, 30px); border-top: 1px solid var(--rule); }
  .expect-item .icon-tile { margin-bottom: 0.35rem; }
  .expect-item .card-title { font-size: var(--step-2); letter-spacing: -0.02em; }
  .expect-item p { margin: 0; color: var(--text-2); }

  .duo { display: grid; gap: clamp(48px, 6vw, 96px); }
  @media (min-width: 900px) { .duo { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .duo-item { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; scroll-margin-top: 96px; }
  .duo-item .icon-tile { margin-bottom: 0.5rem; }
  .duo-item h2 { margin: 0; }
  .duo-item p { color: var(--text-2); font-size: var(--step-1); line-height: 1.6; max-width: 34rem; margin: 0.4rem 0 0.9rem; }
  .duo-item .text-link { margin-top: auto; }

  /* Getting here: three columns on hairlines. */
  .here { display: grid; gap: clamp(36px, 4vw, 48px) clamp(24px, 3vw, 48px); }
  @media (min-width: 900px) { .here { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .here-item { display: flex; flex-direction: column; align-items: flex-start; gap: 0.55rem; padding-top: clamp(22px, 2.4vw, 30px); border-top: 1px solid var(--rule); scroll-margin-top: 96px; }
  .here-item p { margin: 0; color: var(--text-2); }
  .here-item .eyebrow { margin-bottom: 0.4rem; }
  .address { font-size: var(--step-1); line-height: 1.5; color: var(--text) !important; font-weight: 600; margin-bottom: 0.9rem !important; }
  .here-big { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.02em; color: var(--text) !important; }
  .here-item .text-link, .here-item .btn { margin-top: auto; }
  .here-item .text-link { padding-top: 0.5rem; }
  .contact { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .contact li { display: flex; gap: 0.65rem; align-items: center; }
  .contact :global(.icon) { color: var(--accent-text); }
  .contact a { color: var(--text); font-weight: 600; text-underline-offset: 3px; overflow-wrap: anywhere; }
</style>
