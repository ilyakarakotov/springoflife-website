---
// Frequently asked questions: the plain answers a first-time guest (or an AI assistant answering for
// one) looks for, grouped by topic. Text lives in src/content/faq.yaml; the page carries the same
// answers as FAQPage structured data (src/lib/jsonld.ts), and /llms.txt lists them too.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClosingInvite from '../components/ClosingInvite.astro';
import LinkText from '../components/LinkText.astro';
import { faq, forms, external } from '../lib/content';
import { faqJsonLd } from '../lib/jsonld';
import { href, isExternal } from '../lib/url';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base title={faq.title} description={faq.description} jsonLd={faqJsonLd()}>
  <PageHero eyebrow="FAQ" title={faq.title} lead={faq.intro} />

  <section class="section section--tight">
    <div class="wrap faq">
      {faq.sections.map((s) => (
        <section class="faq-group" id={slug(s.title)} aria-labelledby={`${slug(s.title)}-title`}>
          <h2 id={`${slug(s.title)}-title`} data-reveal="lines">{s.title}</h2>
          <div class="faq-list">
            {s.questions.map((x) => (
              <article class="faq-item" data-reveal>
                <h3 class="card-title">{x.q}</h3>
                <p>{x.a}</p>
                {x.link && <a class="text-link" href={href(x.link.url)} {...external(x.link.url)}><LinkText text={x.link.label} icon={isExternal(x.link.url) ? 'external' : 'arrow'} /></a>}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <ClosingInvite title="Still have a question?" text="Tell us a little about yourself on a connect card." cta="Fill out a connect card" url={forms.connect} />
</Base>

<style>
  /* Each topic: its name on the left, the questions on hairlines on the right (stacked on phones). */
  .faq { display: grid; gap: clamp(56px, 7vw, 96px); }
  .faq-group { display: grid; gap: clamp(20px, 3vw, 48px); scroll-margin-top: 96px; }
  @media (min-width: 900px) { .faq-group { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); align-items: start; } }
  .faq-group h2 { margin: 0; max-width: 14ch; }
  .faq-list { display: grid; gap: clamp(28px, 3vw, 36px); }
  .faq-item { display: grid; justify-items: start; gap: 0.6rem; padding-top: clamp(20px, 2.2vw, 26px); border-top: 1px solid var(--rule); }
  .faq-item .card-title { font-size: var(--step-1); letter-spacing: -0.015em; }
  .faq-item p { margin: 0; max-width: 40rem; color: var(--text-2); line-height: 1.6; }
  .faq-item .text-link { margin-top: 0.2rem; }
</style>
