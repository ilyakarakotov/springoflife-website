---
import { getEntry, render } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, img, leaders, beliefs } from '../lib/content';
import { lqip } from '../lib/lqip';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(page);
const PHOTO = '/src/assets/photos/sanctuary.jpg';
const preview = await lqip(PHOTO);
// Elders get their own row: their portraits come from a different shoot, so the split reads as
// intentional rather than inconsistent. Titles are as on the current English site.
const isElder = (role: string) => /\belder\b/i.test(role);
const pastors = leaders.filter((l) => !isElder(l.role));
const elders = leaders.filter((l) => isElder(l.role));
const [missionLead, ...missionRest] = site.mission.split(/(?<=\.)\s+/);
---
<Base title={page.data.title} description={page.data.description}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow eyebrow--accent eyebrow--wave">About us</span>
      <h1>{missionLead}</h1>
      {missionRest.length > 0 && <p class="lead">{missionRest.join(' ')}</p>}
    </div>
  </section>

  <div class="wrap about-photo-wrap">
    <figure class="about-photo">
      <img class="lqip" {...preview} alt="" aria-hidden="true" />
      <Picture src={img(PHOTO)} alt="The congregation listening to a Sunday sermon in the Spring of Life sanctuary" widths={[640, 960, 1440, 2000]}
        sizes="(min-width: 1240px) 1160px, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="about-img" />
    </figure>
  </div>

  <section class="section section--tight story-section">
    <div class="wrap"><div class="prose story"><Content /></div></div>
  </section>

  <section class="section section--soft" id="beliefs" aria-labelledby="beliefs-title">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Statement of faith</span><h2 id="beliefs-title">What we believe</h2><p class="lead">{beliefs.intro}</p></div>
      </div>
      <dl class="beliefs">
        {beliefs.beliefs.map((b) => <div class="belief"><dt>{b.title}</dt><dd>{b.text}</dd></div>)}
      </dl>
      {beliefs.show_affiliations && (
        <div class="affiliations">
          <p><a href={beliefs.statement.url} target="_blank" rel="noopener">{beliefs.statement.label}</a>: {beliefs.statement.text}</p>
          <ul>{beliefs.affiliations.map((a) => <li><a href={a.url} target="_blank" rel="noopener">{a.name}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="leadership" aria-labelledby="leaders-title">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Leadership</span><h2 id="leaders-title">Our pastors and leaders</h2>
          <p class="lead">Our team is ready to serve and to answer any questions you may have.</p></div>
      </div>
      <ul class="leaders">
        {pastors.map((l) => (
          <li>
            <Image src={img(l.photo)} alt={`${l.name}, ${l.role}`} widths={[320, 480]} width={480} sizes="(min-width: 1100px) 230px, (min-width: 720px) 30vw, 45vw" class="leader-img" />
            <b>{l.name}</b><span>{l.role}</span>
          </li>
        ))}
      </ul>
      {elders.length > 0 && (
        <>
          <h3 class="elders-title">Elders</h3>
          <ul class="leaders">
            {elders.map((l) => (
              <li>
                <Image src={img(l.photo)} alt={`${l.name}, ${l.role}`} widths={[320, 480]} width={480} sizes="(min-width: 1100px) 230px, (min-width: 720px) 30vw, 45vw" class="leader-img" />
                <b>{l.name}</b><span>{l.role}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .page-hero h1 { max-width: 14ch; }
  .page-hero { padding-bottom: clamp(96px, 12vw, 160px); }
  .about-photo-wrap { margin-top: clamp(-120px, -9vw, -64px); }
  .about-photo { position: relative; margin: 0; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); background: var(--surface-soft); }
  @media (min-width: 960px) { .about-photo { aspect-ratio: 21 / 9; } }
  .about-photo > .lqip, .about-photo :global(picture), .about-photo :global(.about-img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .about-photo > .lqip, .about-photo :global(.about-img) { object-fit: cover; object-position: 50% 45%; }
  .story { font-size: var(--step-1); line-height: 1.6; }
  .story :global(h2) { font-size: var(--step-3); margin-top: 0; }
  .story :global(p:last-child) { font-style: italic; color: var(--text); }

  .beliefs { margin: 0; display: grid; column-gap: clamp(32px, 5vw, 72px); }
  @media (min-width: 860px) { .beliefs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .belief { padding: 1.25rem 0; border-top: 1px solid var(--border-strong); }
  .belief dt { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.015em; margin-bottom: 0.4rem; }
  .belief dd { margin: 0; color: var(--text-2); }
  .affiliations { margin-top: 2rem; color: var(--text-2); }
  .affiliations a { color: var(--accent-text); }

  .leaders { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 720px) { .leaders { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .leaders { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 24px; } }
  .leaders li { display: grid; gap: 0.15rem; }
  .leaders :global(.leader-img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 22%; border-radius: var(--radius-media); margin-bottom: 0.75rem; background: var(--surface-soft); }
  .leaders b { font-size: 1.0625rem; }
  .leaders span { color: var(--muted); font-size: 0.9375rem; }
  .elders-title { font-size: 1.25rem; margin: clamp(40px, 5vw, 64px) 0 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
</style>
