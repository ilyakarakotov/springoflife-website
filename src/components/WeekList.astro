---
// Weekly schedule, option A: the whole week as a list, Monday to Sunday, beside "Coming up" on
// Home. Today (church time) is tinted by src/scripts/week.ts. The "Today" label always holds its
// place and only becomes visible, so marking the day moves nothing; without JavaScript the week
// shows unmarked. The week comes from src/lib/schedule.mjs.
import Icon from './Icon.astro';
import { week } from '../lib/content';
import { timeSpan } from '../lib/schedule.mjs';
import { href } from '../lib/url';

interface Props {
  headingLevel?: 'h2' | 'h3';
  /** Prefix for the ids, when a page shows the schedule twice. */
  id?: string;
}
const { headingLevel: H = 'h3', id = 'week' } = Astro.props;
---
<aside class="wl panel" aria-labelledby={`${id}-title`} data-week data-reveal>
  <H id={`${id}-title`} class="wl-title">Every week</H>
  <ol class="wl-days">
    {week.map((d) => (
      <li class="wl-day" data-day={d.name}>
        <p class="wl-name"><span aria-hidden="true">{d.short}</span><span class="visually-hidden">{d.name}</span><span class="wl-today">Today</span></p>
        {d.items.length ? (
          <ul class="wl-items">
            {d.items.map((it) => (
              <li>
                <a href={href(it.href)} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  <span class="wl-what">
                    <span class="wl-item">{it.title}{it.external && <Icon name="external" />}</span>
                    {it.detail && <span class="wl-detail">{it.detail}</span>}
                  </span>
                  {it.start !== null && <span class="wl-when tabular">{timeSpan(it.start, it.end)}</span>}
                </a>
              </li>
            ))}
          </ul>
        ) : <p class="wl-none">No regular activities</p>}
      </li>
    ))}
  </ol>
  <p class="wl-note meta">Holidays and school breaks can change the schedule.</p>
</aside>

<style>
  .wl { padding: clamp(22px, 2.8vw, 34px); align-self: start; }
  .wl-title { font-size: 1.25rem; margin: 0 0 0.75rem; }
  .wl-days { list-style: none; margin: 0; padding: 0; }
  .wl-day { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); gap: 0 0.75rem; padding: 0.55rem 0.6rem; margin-inline: -0.6rem; border-top: 1px solid var(--border); border-radius: var(--radius-xs); }
  .wl-name { margin: 0; padding-top: 0.5rem; display: grid; align-content: start; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); line-height: 1.3; }
  .wl-today { visibility: hidden; font-size: 0.625rem; color: var(--accent-text); }
  .wl-day[data-today] { background: var(--accent-soft); border-top-color: transparent; }
  .wl-day[data-today] + .wl-day { border-top-color: transparent; }
  .wl-day[data-today] .wl-name { color: var(--accent-text); }
  .wl-day[data-today] .wl-today { visibility: visible; }
  .wl-items { list-style: none; margin: 0; padding: 0; }
  .wl-items a { display: flex; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem; padding: 0.4rem 0; text-decoration: none; line-height: 1.35; }
  .wl-what { display: grid; min-width: 0; }
  .wl-item { font-weight: 700; }
  .wl-item :global(.icon) { display: inline-block; width: 0.8em; height: 0.8em; margin-left: 0.3em; vertical-align: -0.02em; color: var(--text-2); }
  .wl-detail { color: var(--muted); font-size: 0.875rem; }
  .wl-when { flex: none; color: var(--text-2); font-size: 0.9375rem; white-space: nowrap; }
  .wl-items a:hover .wl-item { text-decoration: underline; text-underline-offset: 3px; }
  .wl-none { margin: 0; padding: 0.4rem 0; color: var(--muted); font-size: 0.9375rem; line-height: 1.35; }
  .wl-note { margin: 0.5rem 0 0; padding-top: 0.9rem; border-top: 1px solid var(--border); }
</style>
