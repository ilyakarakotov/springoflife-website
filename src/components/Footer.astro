---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { site, forms, ministries } from '../lib/content';
import { href, isExternal } from '../lib/url';

const year = new Date().getFullYear();
const tel = site.phone.replace(/[^\d+]/g, '');
// The three schools (ministry-links.yaml, group "schools"): their own site when they have one,
// otherwise their card on the Ministries page.
const schools = ministries.filter((m) => m.group === 'schools').map((m) => ({ label: m.title, url: m.link && isExternal(m.link) ? m.link : `/ministries#${m.id}` }));
const cols = [
  { title: 'Explore', links: [['Plan a visit', '/visit'], ['About us', '/about'], ['Ministries', '/ministries'], ['Life Groups', '/life-groups'], ['Watch', '/watch'], ['Events', '/events']] },
  { title: 'Connect', links: [['Next steps', '/next-steps'], ['Connect card', forms.connect], ['Prayer request', forms.prayer], ['Serve', forms.serve], ['Give', '/give']] },
  { title: 'Schools', links: schools.map((s) => [s.label, s.url]) },
];
const social = [
  { label: 'YouTube', url: site.links.youtube, icon: 'youtube' },
  { label: 'Instagram', url: site.links.instagram, icon: 'instagram' },
  { label: 'Facebook', url: site.links.facebook, icon: 'facebook' },
] as const;
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="f-brand" href={href('/')}>
        <BrandMark />
        <span class="f-brand-text"><b>Spring of Life</b><span>Church</span></span>
      </a>
      <dl class="f-services">
        <div><dt>English service</dt><dd>{site.service.day}s {site.service.time}</dd></div>
        <div><dt>Russian service</dt><dd>{site.service.day}s {site.service.russian_time}</dd></div>
      </dl>
      <p class="f-address">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal_code}</p>
      <p class="f-contact"><a href={`tel:${tel}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <a class="btn btn--sm f-cta" href={href('/visit')}>Plan a visit</a>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2>{c.title}</h2>
        <ul>
          {c.links.map(([label, url]) => {
            if (!isExternal(url)) return <li><a href={href(url)}>{label}</a></li>;
            // The arrow stays on the line of the last word ("SOL Christian Academy ↗" wrapped the arrow alone).
            const cut = label.lastIndexOf(' ') + 1;
            return <li><a href={href(url)} target="_blank" rel="noopener">{label.slice(0, cut)}<span class="f-tail">{label.slice(cut)}<Icon name="external" /></span></a></li>;
          })}
        </ul>
      </nav>
    ))}
  </div>
  <div class="wrap footer-follow">
    <ul class="social" aria-label="Follow us">
      {social.map((s) => <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} /></a></li>)}
    </ul>
    <p class="apps">The Spring of Life app: <a href={site.links.app_ios} target="_blank" rel="noopener">iPhone</a> · <a href={site.links.app_android} target="_blank" rel="noopener">Android</a></p>
  </div>
  <div class="wrap">
    <div class="footer-bottom">
      <span>© {year} {site.name} · {site.address.city}, {site.address.region}</span>
      <a href={site.links.russian_site} hreflang="ru" lang="ru">Русский сайт</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--footer-bg); color: var(--on-dark-2); padding-top: clamp(48px, 7vw, 88px); font-size: 0.95rem; }
  @media (prefers-color-scheme: dark) { .site-footer { border-top: 1px solid rgb(255 255 255 / 0.07); } }
  .footer-grid { display: grid; gap: 2.25rem 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .footer-brand { grid-column: 1 / -1; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .footer-grid { grid-template-columns: 1.5fr 1fr 1fr 1fr; } .footer-brand { grid-column: auto; } }
  .f-brand { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--on-dark); text-decoration: none; margin-bottom: 1.5rem; border-radius: 8px; }
  .f-brand :global(.brand-mark) { width: 38px; height: 38px; flex: none; }
  .f-brand-text { display: flex; flex-direction: column; line-height: 1; text-transform: uppercase; }
  .f-brand-text b { font-size: 1.12rem; font-weight: 800; letter-spacing: 0.01em; }
  .f-brand-text span { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.32em; margin-top: 4px; opacity: 0.9; }
  .f-services { margin: 0 0 1rem; display: grid; gap: 0.35rem; }
  .f-services div { display: flex; gap: 0.75rem; }
  .f-services dt { min-width: 8.5rem; color: var(--on-dark-2); }
  .f-services dd { margin: 0; color: var(--on-dark); font-weight: 700; }
  .f-address, .f-contact { margin: 0 0 1rem; }
  .f-cta { margin-top: 0.5rem; border-color: rgb(255 255 255 / 0.55); color: #fff; background: transparent; }
  .f-cta:hover { border-color: #fff; background: rgb(255 255 255 / 0.1); }
  .site-footer h2 { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-dark); margin: 0 0 1rem; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .site-footer a { color: var(--on-dark-2); text-decoration: none; }
  .site-footer a:hover { color: var(--on-dark); text-decoration: underline; text-underline-offset: 3px; }
  .f-tail { white-space: nowrap; }
  .site-footer nav :global(.icon) { display: inline-block; width: 0.85em; height: 0.85em; margin-left: 0.3em; vertical-align: -0.05em; opacity: 0.7; }
  .footer-follow { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: clamp(36px, 5vw, 56px); }
  .social { display: flex !important; gap: 0.5rem !important; }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.18); color: var(--on-dark); }
  .social a:hover { background: rgb(255 255 255 / 0.1); border-color: rgb(255 255 255 / 0.4); }
  .social :global(.icon) { width: 20px; height: 20px; }
  .apps { margin: 0; }
  .apps a { color: var(--on-dark); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgb(255 255 255 / 0.35); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; padding-block: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.1); font-size: 0.875rem; }
  .footer-bottom a { color: var(--on-dark); font-weight: 700; }
  /* Focus rings on the dark footer: light ring, dark gap. */
  .site-footer :focus-visible { outline-color: #fff; box-shadow: 0 0 0 4px var(--footer-bg); }
</style>
