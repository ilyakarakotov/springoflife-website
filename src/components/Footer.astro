---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { site, forms, ministries } from '../lib/content';
import { href, isExternal } from '../lib/url';

const year = new Date().getFullYear();
const tel = site.phone.replace(/[^\d+]/g, '');
// The three schools (ministry-links.yaml, group "schools"): their own site when they have one,
// otherwise their card on the Ministries page.
const schools = ministries.filter((m) => m.group === 'schools').map((m) => ({ label: m.title, url: m.link && isExternal(m.link) ? m.link : `/ministries#${m.id}` }));
const cols = [
  { title: 'Explore', links: [['Plan a visit', '/visit'], ['About us', '/about'], ['Ministries', '/ministries'], ['Life Groups', '/life-groups'], ['Watch', '/watch'], ['Events', '/events']] },
  { title: 'Connect', links: [['Next steps', '/next-steps'], ['Connect card', forms.connect], ['Prayer request', forms.prayer], ['Serve', forms.serve], ['Give', '/give']] },
  { title: 'Schools', links: schools.map((s) => [s.label, s.url]) },
];
const social = [
  { label: 'YouTube', url: site.links.youtube, icon: 'youtube' },
  { label: 'Instagram', url: site.links.instagram, icon: 'instagram' },
  { label: 'Facebook', url: site.links.facebook, icon: 'facebook' },
] as const;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <a class="f-brand" href={href('/')}>
        <BrandMark />
        <span class="f-brand-text"><b>Spring of Life</b><span>Church</span></span>
      </a>
      <p class="f-tagline">{site.tagline}</p>
      <ul class="social" aria-label="Follow us">
        {social.map((s) => <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} /></a></li>)}
      </ul>
    </div>
    <div class="footer-grid">
      <div class="f-visit">
        <h2>Sunday services</h2>
        <dl class="f-services">
          <div><dt>English</dt><dd class="tabular">{site.service.day}s {site.service.time}</dd></div>
          <div><dt>Russian</dt><dd class="tabular">{site.service.day}s {site.service.russian_time}</dd></div>
        </dl>
        <p class="f-address">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal_code}</p>
        <p class="f-contact"><a href={`tel:${tel}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>
            {c.links.map(([label, url]) => {
              if (!isExternal(url)) return <li><a href={href(url)}>{label}</a></li>;
              // The arrow stays on the line of the last word ("SOL Christian Academy ↗" wrapped the arrow alone).
              const cut = label.lastIndexOf(' ') + 1;
              return <li><a href={href(url)} target="_blank" rel="noopener">{label.slice(0, cut)}<span class="f-tail">{label.slice(cut)}<Icon name="external" /></span></a></li>;
            })}
          </ul>
        </nav>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.name} · {site.address.city}, {site.address.region}</span>
      <p class="apps">The Spring of Life app: <a href={site.links.app_ios} target="_blank" rel="noopener">iPhone</a> · <a href={site.links.app_android} target="_blank" rel="noopener">Android</a></p>
      <a class="f-ru" href={site.links.russian_site} hreflang="ru" lang="ru">Русский сайт</a>
    </div>
  </div>
</footer>

<style>
  /* The ink band the closing photo flows into. A faint glow of the church blue low on the right,
     the times first, then the links on hairlines. */
  .site-footer { position: relative; color: var(--on-dark-2); font-size: 0.95rem;
    background: radial-gradient(60% 85% at 90% 100%, rgb(42 91 215 / 0.14), rgb(42 91 215 / 0) 70%), var(--footer-bg); }
  /* In dark mode a hairline separates the footer from the page, except under the closing photo,
     which already ends in the footer's colour. */
  @media (prefers-color-scheme: dark) { .site-footer { box-shadow: 0 -1px 0 rgb(255 255 255 / 0.07); } :global(main:has(> .invite:last-child)) + .site-footer { box-shadow: none; } }
  .site-footer > .wrap { padding-top: clamp(48px, 6vw, 80px); }
  .footer-top { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; padding-bottom: clamp(28px, 3.5vw, 44px); border-bottom: 1px solid rgb(255 255 255 / 0.1); }
  .f-brand { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--on-dark); text-decoration: none; border-radius: 8px; }
  .f-brand :global(.brand-mark) { width: 46px; height: 46px; flex: none; }
  .f-brand-text { display: flex; flex-direction: column; line-height: 1; text-transform: uppercase; }
  .f-brand-text b { font-size: 1.25rem; font-weight: 800; letter-spacing: 0.01em; }
  .f-brand-text span { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.32em; margin-top: 5px; opacity: 0.9; }
  .f-tagline { margin: 0; padding-left: 2rem; border-left: 1px solid rgb(255 255 255 / 0.16); color: var(--on-dark); font-weight: 600; font-size: 1.0625rem; letter-spacing: -0.01em; }
  @media (max-width: 639.98px) { .f-tagline { flex-basis: 100%; padding-left: 0; border-left: 0; } }
  .social { display: flex !important; gap: 0.5rem !important; margin-left: auto !important; }
  @media (max-width: 639.98px) { .social { margin-left: 0 !important; } }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.2); color: var(--on-dark);
    transition: background-color var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease); }
  .social a:hover { background: rgb(255 255 255 / 0.1); border-color: rgb(255 255 255 / 0.45); }
  .social :global(.icon) { width: 20px; height: 20px; }

  .footer-grid { display: grid; gap: 2.5rem 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); padding-block: clamp(36px, 4.5vw, 60px); }
  .f-visit { grid-column: 1 / -1; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; } .f-visit { grid-column: auto; } }
  .site-footer h2 { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-dark); margin: 0 0 1.1rem; }
  .f-services { margin: 0 0 1.25rem; display: grid; gap: 0.4rem; }
  .f-services div { display: flex; gap: 0.75rem; align-items: baseline; }
  .f-services dt { min-width: 5.5rem; color: var(--on-dark-2); }
  .f-services dd { margin: 0; color: var(--on-dark); font-weight: 700; font-size: 1.0625rem; }
  .f-address, .f-contact { margin: 0 0 1rem; line-height: 1.6; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .site-footer a { color: var(--on-dark-2); text-decoration: none; text-underline-offset: 4px; text-decoration-thickness: 1px; transition: color var(--dur-2) var(--ease); }
  .site-footer a:hover { color: var(--on-dark); text-decoration-line: underline; }
  .f-tail { white-space: nowrap; }
  .site-footer nav :global(.icon) { display: inline-block; width: 0.85em; height: 0.85em; margin-left: 0.3em; vertical-align: -0.05em; opacity: 0.7; }
  .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 2rem; padding-block: 1.5rem 1.75rem; border-top: 1px solid rgb(255 255 255 / 0.1); font-size: 0.875rem; }
  .apps { margin: 0 auto 0 0; }
  .apps a, .f-ru { color: var(--on-dark); font-weight: 700; }
  .apps a { text-decoration: underline; text-decoration-color: rgb(255 255 255 / 0.35); }
  @media (max-width: 719.98px) { .apps { flex-basis: 100%; order: -1; } }
  /* Focus rings on the dark footer: light ring, dark gap. */
  .site-footer :focus-visible { outline-color: #fff; box-shadow: 0 0 0 4px var(--footer-bg); }
</style>
