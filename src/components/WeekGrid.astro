---
// Weekly schedule, option C: the week as a calendar, like Google Calendar's week view, under
// "Coming up" on Home. From 700 px wide (a container query, so it also fits a narrower column) each
// day is a column and every item a block sized by its time. Items without an end time fade out, and
// overlapping items share the column the way a calendar app draws them (side by side from 1100 px,
// else stepped in). Items without a time (most Life
// Groups) sit in the all-day row at the top. Narrower, the days become cards, two or four across,
// so a phone never scrolls sideways.
// Today (church time) is marked by src/scripts/week.ts, which also draws the current-time line. Both
// only reveal things that already hold their place, so nothing moves; without JavaScript the week
// shows unmarked. The CSP blocks inline styles, so a block's place is set by classes: at-*/aq-* for
// its start and len-*/lq-* for its length, in hours and quarter hours.
import Icon from './Icon.astro';
import { week } from '../lib/content';
import { timeSpan, gridHours, gridPlaces, hourLabel } from '../lib/schedule.mjs';
import { href } from '../lib/url';

interface Props {
  headingLevel?: 'h2' | 'h3';
  /** Prefix for the ids, when a page shows the schedule twice. */
  id?: string;
}
const { headingLevel: H = 'h3', id = 'week-grid' } = Astro.props;
const { from, to } = gridHours(week);
const hours = Array.from({ length: to - from }, (_, i) => from + i);
const KINDS = { service: 'Sunday services', kids: 'Kids', groups: 'Groups', schools: 'Schools', missions: 'Missions', serve: 'Serving' } as const;
const kinds = (Object.keys(KINDS) as (keyof typeof KINDS)[]).filter((k) => week.some((d) => d.items.some((i) => i.kind === k)));
// 26 quarter hours -> ["at-6", "aq-2"]
const quarters = (n: number, hour: string, part: string) => [`${hour}-${Math.floor(n / 4)}`, n % 4 ? `${part}-${n % 4}` : null];
const days = week.map((d) => ({ ...d, timed: gridPlaces(d.items, from), untimed: d.items.filter((i) => i.start === null) }));
const ext = (external: boolean) => (external ? { target: '_blank', rel: 'noopener' } : {});
---
<section class="wg panel" aria-labelledby={`${id}-title`} data-week data-week-grid data-from={from * 60} data-to={to * 60} data-reveal>
  <div class="wg-head">
    <H id={`${id}-title`} class="wg-title">Every week</H>
    <ul class="wg-key" aria-hidden="true">{kinds.map((k) => <li class={`k-${k}`}>{KINDS[k]}</li>)}</ul>
  </div>
  <div class="wg-grid">
    <div class="wg-axis" aria-hidden="true">{hours.map((h) => <span>{hourLabel(h)}</span>)}</div>
    <div class="wg-lines" aria-hidden="true"></div>
    <ol class="wg-days">
      {days.map((d) => (
        <li class="wg-day" data-day={d.name}>
          <p class="wg-name"><span class="wg-dow" aria-hidden="true">{d.short}</span><span class="visually-hidden">{d.name}</span><span class="wg-today">Today</span></p>
          <div class="wg-slot">
            {d.timed.length > 0 && (
              <ul class="wg-timed">
                {d.timed.map(({ item, offset, length, indent, side, open }) => (
                  <li class:list={['ev', `k-${item.kind}`, ...quarters(offset, 'at', 'aq'), ...quarters(length, 'len', 'lq'), indent ? `in-${indent}` : null, side && `side-${side}`, { open }]}>
                    <a href={href(item.href)} {...ext(item.external)}>
                      <span class="ev-name">{item.short}{item.external && <Icon name="external" />}</span>
                      <span class="ev-when tabular">{timeSpan(item.start ?? 0, item.end)}</span>
                      {item.detail && <span class="ev-detail">{item.detail}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <span class="wg-now" aria-hidden="true"></span>
          </div>
          {d.untimed.length > 0 && (
            <ul class="wg-untimed">
              {d.untimed.map((item) => (
                <li class:list={['ev', `k-${item.kind}`]}>
                  <a href={href(item.href)} {...ext(item.external)}>
                    <span class="ev-name">{item.short}{item.external && <Icon name="external" />}</span>
                    {item.detail && <span class="ev-detail">{item.detail}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {d.items.length === 0 && <p class="wg-none">No regular activities</p>}
        </li>
      ))}
    </ol>
  </div>
  <p class="wg-note meta">Holidays and school breaks can change the schedule.</p>
</section>

<style>
  /* Calendar colours by kind of item, light and dark. Text stays --text on every tint. */
  .wg {
    container: wg / inline-size;
    padding: clamp(18px, 2.4vw, 30px);
    --hour: 48px;
    --service-bg: #e9eefc; --service-bar: #1f56d6;
    --kids-bg: #fcefe0; --kids-bar: #c25e0b;
    --groups-bg: #e3f3e9; --groups-bar: #1f8049;
    --schools-bg: #f0eafb; --schools-bar: #7149c9;
    --other-bg: var(--surface-2); --other-bar: var(--muted);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .wg {
      --service-bg: #1c2846; --service-bar: #8eadff;
      --kids-bg: #36271a; --kids-bar: #f0a25e;
      --groups-bg: #15301f; --groups-bar: #6fcf98;
      --schools-bg: #2a2243; --schools-bar: #b49cf2;
    }
  }
  :global(:root[data-theme="dark"]) .wg {
    --service-bg: #1c2846; --service-bar: #8eadff;
    --kids-bg: #36271a; --kids-bar: #f0a25e;
    --groups-bg: #15301f; --groups-bar: #6fcf98;
    --schools-bg: #2a2243; --schools-bar: #b49cf2;
  }
  .k-service { --k-bg: var(--service-bg); --k-bar: var(--service-bar); }
  .k-kids { --k-bg: var(--kids-bg); --k-bar: var(--kids-bar); }
  .k-groups { --k-bg: var(--groups-bg); --k-bar: var(--groups-bar); }
  .k-schools { --k-bg: var(--schools-bg); --k-bar: var(--schools-bar); }
  .k-missions, .k-serve { --k-bg: var(--other-bg); --k-bar: var(--other-bar); }

  .wg-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; margin-bottom: 1rem; }
  .wg-title { font-size: 1.25rem; margin: 0; }
  .wg-key { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0; padding: 0; font-size: 0.8125rem; color: var(--muted); }
  .wg-key li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .wg-key li::before { content: ''; width: 0.625rem; height: 0.625rem; border-radius: 3px; background: var(--k-bar); }

  /* Narrow: one card per day, two across (four from 520 px). Sunday spans two. */
  .wg-axis, .wg-lines, .wg-now { display: none; }
  .wg-days { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  @container wg (min-width: 520px) { .wg-days { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .wg-day { display: flex; flex-direction: column; gap: 6px; min-width: 0; padding: 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .wg-day[data-day="Sunday"] { grid-column: span 2; }
  .wg-name { display: flex; justify-content: space-between; gap: 0.5rem; margin: 0; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); line-height: 1.3; }
  .wg-today { visibility: hidden; color: var(--accent-text); }
  .wg-day[data-today] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .wg-day[data-today] .wg-name { color: var(--accent-text); }
  .wg-day[data-today] .wg-today { visibility: visible; }
  .wg-slot { display: contents; }
  .wg-timed, .wg-untimed { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .ev a { position: relative; display: grid; align-content: start; padding: 4px 6px 5px 10px; border-radius: 6px; background: var(--k-bg); color: var(--text); text-decoration: none; line-height: 1.25; }
  .ev a::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; border-radius: 6px 0 0 6px; background: var(--k-bar); }
  .ev-name { font-weight: 700; font-size: 0.875rem; overflow-wrap: anywhere; }
  .ev-name :global(.icon) { display: inline-block; width: 0.75em; height: 0.75em; margin-left: 0.25em; vertical-align: -0.02em; }
  .ev-when, .ev-detail { font-size: 0.75rem; color: var(--text-2); }
  .ev a:hover .ev-name { text-decoration: underline; text-underline-offset: 2px; }
  .wg-none { margin: 0; font-size: 0.8125rem; color: var(--muted); line-height: 1.3; }
  .wg-note { margin: 1rem 0 0; }

  /* Wide: the calendar. Time runs down the left; the days share its rows through subgrid, so the
     all-day row lines up across the week. */
  @container wg (min-width: 700px) {
    .wg-grid { display: grid; grid-template-columns: 3.5rem repeat(7, minmax(0, 1fr)); grid-template-rows: auto auto auto; }
    .wg-axis { display: grid; grid-column: 1; grid-row: 3; grid-auto-rows: var(--hour); }
    .wg-axis span { padding-right: 0.6rem; font-size: 0.75rem; line-height: 1; color: var(--muted); text-align: right; white-space: nowrap; translate: 0 -0.5em; }
    .wg-lines { display: block; grid-column: 2 / -1; grid-row: 3; border-bottom: 1px solid var(--border); background: repeating-linear-gradient(to bottom, var(--border) 0 1px, transparent 1px var(--hour)); }
    .wg-days { grid-column: 2 / -1; grid-row: 1 / -1; grid-template-columns: subgrid; grid-template-rows: subgrid; gap: 0; }
    .wg-day, .wg-day[data-day="Sunday"] { grid-column: auto; grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; gap: 0; padding: 0; border: 0; border-left: 1px solid var(--border); border-radius: 0; }
    .wg-day[data-today] { border-color: var(--border); }
    .wg-name { grid-row: 1; flex-direction: column; justify-content: start; align-items: center; gap: 3px; padding-bottom: 8px; }
    .wg-dow { padding: 0.15rem 0.6rem; border-radius: 999px; }
    .wg-today { font-size: 0.625rem; }
    .wg-day[data-today] .wg-dow { background: var(--accent); color: var(--accent-ink); }
    .wg-untimed { grid-row: 2; align-content: start; padding: 0 3px 4px; }
    .wg-slot { display: block; grid-row: 3; position: relative; }
    .wg-timed { display: block; position: absolute; inset: 0; }
    .wg-timed .ev { position: absolute; inset-inline: 3px;
      top: calc((var(--t, 0) * 4 + var(--tq, 0)) * var(--hour) / 4 + 1px);
      height: calc((var(--l, 0) * 4 + var(--lq, 0)) * var(--hour) / 4 - 2px); }
    .wg-timed .ev a { height: 100%; overflow: hidden; }
    .ev-name { font-size: 0.8125rem; }
    /* No end time: as tall as its text, fading out. */
    .wg-timed .ev.open { height: auto; }
    .wg-timed .ev.open a { height: auto; min-height: calc(var(--hour) - 2px); background: linear-gradient(to bottom, var(--k-bg) 45%, transparent); }
    .wg-timed .ev.open a::before { background: linear-gradient(to bottom, var(--k-bar) 45%, transparent); }
    /* Overlaps step in, with a gap in the panel colour so the edges read. */
    .wg-timed .ev.in-1 { inset-inline-start: 32%; z-index: 1; }
    .wg-timed .ev.in-2 { inset-inline-start: 56%; z-index: 2; }
    .ev.in-1 a, .ev.in-2 a { box-shadow: -2px -2px 0 0 var(--surface); }
    /* Two items starting close together: the later one covers the lower part of the first here
       (its title stays readable), and they sit side by side from 1100 px (below). */
    .wg-timed .ev.side-right { z-index: 1; }
    .ev.side-right a { box-shadow: 0 -2px 0 0 var(--surface); }
    .wg-none { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    /* The current time on today's column (src/scripts/week.ts sets --now, in minutes from the top). */
    .wg-now { position: absolute; inset-inline: 0; z-index: 3; top: calc(var(--now, 0) * var(--hour) / 60 - 1px); height: 2px; background: var(--accent); pointer-events: none; }
    .wg-now::before { content: ''; position: absolute; left: -5px; top: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
    .wg[data-now] .wg-day[data-today] .wg-now { display: block; }
  }
  /* Columns under about 150 px: titles stay on one line, so a covered or stepped-in block still
     shows its whole title. */
  @container wg (min-width: 700px) and (max-width: 1099.98px) {
    .ev-name { font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ev-name :global(.icon) { display: none; }
    .wg-timed .ev.in-1 { inset-inline-start: 20%; }
    .wg-timed .ev.in-2 { inset-inline-start: 40%; }
  }
  @container wg (min-width: 1100px) {
    .wg-timed .ev.side-left { inset-inline-end: calc(50% + 1px); }
    .wg-timed .ev.side-right { inset-inline-start: calc(50% + 1px); }
    .ev.side-right a { box-shadow: none; }
  }

  /* Block places, in hours (at-*, len-*) and quarter hours (aq-*, lq-*). */
  .at-1 { --t: 1; } .at-2 { --t: 2; } .at-3 { --t: 3; } .at-4 { --t: 4; } .at-5 { --t: 5; } .at-6 { --t: 6; }
  .at-7 { --t: 7; } .at-8 { --t: 8; } .at-9 { --t: 9; } .at-10 { --t: 10; } .at-11 { --t: 11; } .at-12 { --t: 12; }
  .at-13 { --t: 13; } .at-14 { --t: 14; } .at-15 { --t: 15; } .at-16 { --t: 16; } .at-17 { --t: 17; }
  .aq-1 { --tq: 1; } .aq-2 { --tq: 2; } .aq-3 { --tq: 3; }
  .len-1 { --l: 1; } .len-2 { --l: 2; } .len-3 { --l: 3; } .len-4 { --l: 4; } .len-5 { --l: 5; } .len-6 { --l: 6; }
  .len-7 { --l: 7; } .len-8 { --l: 8; } .len-9 { --l: 9; } .len-10 { --l: 10; } .len-11 { --l: 11; } .len-12 { --l: 12; }
  .len-13 { --l: 13; } .len-14 { --l: 14; } .len-15 { --l: 15; } .len-16 { --l: 16; } .len-17 { --l: 17; }
  .lq-1 { --lq: 1; } .lq-2 { --lq: 2; } .lq-3 { --lq: 3; }
</style>
