---
// One ongoing ministry (src/content/ministry-links.yaml). Facts (day, ages, cost) are a plain list,
// not checkmarks. A logo (image_fit: logo) is shown whole on a light tile, like a sticker, instead
// of being cropped as a photo.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { img, external } from '../lib/content';
import { isPlaceholder } from '../lib/placeholders.mjs';
import { href } from '../lib/url';
import type { ministries } from '../lib/content';
interface Props { item: (typeof ministries)[number]; compact?: boolean; media?: boolean; headingLevel?: 'h2' | 'h3' }
const { item: m, compact = false, media = true, headingLevel: H = 'h3' } = Astro.props;
const showMedia = media && !compact && Boolean(m.image);
const logo = m.image_fit === 'logo';
---
<article class:list={['ministry card', { 'ministry--compact': compact }]} id={m.id}>
  {showMedia && m.image && (
    <div class:list={['ministry-media', { 'ministry-media--logo': logo }]}>
      <Image src={img(m.image)} alt="" widths={[400, 720]} width={720} sizes="(min-width: 960px) 30vw, (min-width: 640px) 45vw, 100vw" />
    </div>
  )}
  <div class="ministry-body">
    <H class="card-title">{m.title}</H>
    <p class:list={{ 'needs-text': isPlaceholder(m.summary) }}>{m.summary}</p>
    {!compact && m.details && (
      <ul class="facts-list">
        {m.details.map((d) => <li class:list={{ 'needs-text': isPlaceholder(d) }}>{d}</li>)}
      </ul>
    )}
    {m.href && m.cta && (
      <a class="text-link" href={href(m.href)} {...external(m.href)}>{m.cta}<Icon name={m.href.startsWith('/') ? 'arrow' : 'external'} /></a>
    )}
  </div>
</article>
<style>
  .ministry { overflow: hidden; display: flex; flex-direction: column; scroll-margin-top: 96px; }
  .ministry-media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface-soft); }
  .ministry-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* A logo is a sticker on a light tile: whole, centred, never cropped (also in dark mode). */
  .ministry-media--logo { display: grid; place-items: center; padding: clamp(16px, 3vw, 28px); background: #f4f4f1; border-bottom: 1px solid var(--border); }
  .ministry-media--logo :global(img) { width: auto; height: 100%; max-width: 100%; object-fit: contain; border-radius: 8px; }
  .ministry-body { display: flex; flex-direction: column; gap: 0.75rem; padding: clamp(20px, 2.4vw, 28px); flex: 1; }
  .ministry-body p { margin: 0; color: var(--text-2); }
  .ministry-body .text-link { margin-top: auto; padding-top: 0.5rem; }
</style>
