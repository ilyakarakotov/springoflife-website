---
// Subsplash Giving, click to load. The embedded form sets a Stripe cookie (m.stripe.com) and
// Subsplash cookies as soon as it loads, which cost Best Practices 77 on /give (review P1-11) and
// break "no cookies by default". Nothing loads until the visitor presses "Give online"; the form
// then appears in place and gets focus. "Open giving in a new tab" always works, also without
// JavaScript. Payments, receipts and recurring gifts stay in Subsplash.
// The white Subsplash form sits in a deliberate frame (also in dark mode) sized to its tallest
// step, so there's no slab of dead white under it; the form scrolls inside if a step is longer.
import Icon from './Icon.astro';
import LinkText from './LinkText.astro';
import { site } from '../lib/content';
---
<div class="give-frame">
  <p class="give-strip"><Icon name="lock" />Secure giving through Subsplash</p>
  <div class="give-facade" data-facade data-src={site.embeds.give} data-title="Give to Spring of Life Church (secure Subsplash form)">
    <div class="give-facade-body">
      <h2 class="give-title">Give online</h2>
      <p>Give once or set up a recurring gift. The secure giving form from Subsplash, our giving provider, opens right here.</p>
      <div class="btn-row">
        <button type="button" class="btn btn--primary give-load" data-facade-load>Give online</button>
        <a class="text-link" href={site.links.give} target="_blank" rel="noopener"><LinkText text="Open giving in a new tab" icon="external" /></a>
      </div>
      <p class="meta give-note">Nothing from Subsplash loads until you choose one of these.</p>
    </div>
  </div>
</div>

{/* The click-to-load behaviour is src/scripts/facade.ts, loaded by Base.astro (src/scripts/site.ts). */}

<style>
  .give-frame { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-1); }
  .give-strip { display: flex; align-items: center; gap: 0.5rem; margin: 0; padding: 12px clamp(18px, 3vw, 28px); border-bottom: 1px solid var(--border); font-size: 0.875rem; font-weight: 700; color: var(--text-2); background: var(--bg-soft); }
  .give-strip :global(.icon) { color: var(--accent-text); }
  .give-facade-body { padding: clamp(24px, 4vw, 44px); }
  .give-title { font-size: var(--step-3); margin-bottom: 0.4em; }
  .give-facade-body > p { color: var(--text-2); max-width: 34rem; }
  .give-note { margin: 1.25rem 0 0; }
  .give-facade.is-loaded { padding: 8px; }
  .give-facade :global(iframe) { display: block; width: 100%; height: 700px; border: 0; border-radius: var(--radius-sm); background: #fff; }
  @media (min-width: 640px) { .give-facade :global(iframe) { height: 720px; } }
  @media (scripting: none) { .give-load { display: none; } .give-note { display: none; } }
</style>
