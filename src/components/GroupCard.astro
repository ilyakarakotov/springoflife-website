---
// A Life Group card shows only what the leaders publish for everyone: when, roughly where, an
// optional group type, and the Church Center link. Never the bio (it isn't even in the data).
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { PublicGroup } from '../lib/content';
import { img } from '../lib/content';
import { groupTagline, joinLabel } from '../lib/groups.mjs';
import { syncedImage, CARD_WIDTHS } from '../lib/media';

interface Props { group: PublicGroup; eager?: boolean }
const { group: g, eager = false } = Astro.props;
const joinable = g.enrollment.status === 'open';
const cta = joinLabel(g.enrollment);
const tagline = groupTagline(g.audience);
const pic = g.picture;
const image = pic.kind === 'synced' ? syncedImage(pic.file) : pic.kind === 'asset' ? img(pic.path) : null;
const loading = eager ? { loading: 'eager' as const, fetchpriority: 'high' as const } : { loading: 'lazy' as const };
---
<article class="group card">
  {image
    ? <Picture src={image} alt="" widths={CARD_WIDTHS} width={720} height={405} fit="cover" sizes="(min-width: 1240px) 380px, (min-width: 960px) 30vw, (min-width: 640px) 46vw, 100vw"
        formats={['avif', 'webp']} class="media-16x9" {...loading} />
    : <div class="media-16x9 group-noimg" aria-hidden="true"><Icon name="users" /></div>}
  <div class="group-body">
    <h3>{g.title}</h3>
    {g.schedule
      ? <p class="group-meta"><Icon name="clock" /><span>{g.schedule}</span></p>
      : <p class="group-meta group-meta--muted"><Icon name="clock" /><span>Day and time on Church Center</span></p>}
    {g.area && <p class="group-meta"><Icon name="pin" /><span>{g.area}</span></p>}
    {g.virtual && <p class="group-meta"><Icon name="globe" /><span>Meets online</span></p>}
    {tagline && <p class="group-summary">{tagline}</p>}
    <div class="group-actions">
      <a class="btn btn--sm btn--outline" href={g.url} target="_blank" rel="noopener">
        {cta}<span class="visually-hidden"> ({g.title} on Church Center)</span><Icon name="external" />
      </a>
      {!joinable && g.enrollment.status && <span class="chip">{g.enrollment.status === 'full' ? 'Full' : 'Closed'}</span>}
    </div>
  </div>
</article>

<style>
  .group { overflow: hidden; display: flex; flex-direction: column; }
  .group-noimg { display: grid; place-items: center; color: var(--muted); background: var(--bg-tint); }
  .group-noimg :global(.icon) { width: 40px; height: 40px; }
  .group-body { display: flex; flex-direction: column; gap: 0.5rem; padding: clamp(18px, 2.2vw, 24px); flex: 1; }
  .group-body h3 { font-size: var(--step-1); margin: 0; }
  .group-meta { display: flex; gap: 0.5rem; margin: 0; font-weight: 600; color: var(--accent-text); font-size: 0.95rem; }
  .group-meta--muted { color: var(--text-2); font-weight: 500; }
  .group-meta :global(.icon) { margin-top: 0.2em; }
  .group-summary { margin: 0; color: var(--text-2); font-size: 0.95rem; }
  .group-actions { display: flex; align-items: center; gap: 0.6rem; margin-top: auto; padding-top: 0.75rem; }
</style>
