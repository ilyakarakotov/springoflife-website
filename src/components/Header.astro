---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { site } from '../lib/content';
import { href, pagePath } from '../lib/url';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = pagePath(Astro.url.pathname);
// "Plan a visit" is the call to action (header button, and the first item of the phone menu), so
// Visit isn't repeated as a plain link. Life Groups shows under Ministries in the phone menu.
const nav = [
  { href: '/about', label: 'About' },
  { href: '/ministries', label: 'Ministries', also: ['/life-groups'], sub: { href: '/life-groups', label: 'Life Groups' } },
  { href: '/watch', label: 'Watch' },
  { href: '/events', label: 'Events' },
  { href: '/next-steps', label: 'Next Steps' },
  { href: '/give', label: 'Give' },
];
const isCurrent = (item: (typeof nav)[number]) => path === item.href || (item.also ?? []).includes(path) || path.startsWith(`${item.href}/`);
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="wrap header-row">
    <a class="brand" href={href('/')}>
      <BrandMark define />
      <span class="brand-text"><b>Spring of Life</b> <span>Church</span></span>
    </a>
    <nav class="nav" id="site-nav" aria-label="Main">
      <a class="btn btn--primary nav-cta" href={href('/visit')} aria-current={path === '/visit' ? 'page' : undefined}>Plan a visit<Icon name="arrow" /></a>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={href(item.href)} aria-current={path === item.href ? 'page' : isCurrent(item) ? 'true' : undefined}>{item.label}</a>
            {item.sub && <a class="nav-sub" href={href(item.sub.href)} aria-current={path === item.sub.href ? 'page' : undefined}>{item.sub.label}</a>}
          </li>
        ))}
      </ul>
      <p class="nav-service">{site.service.day}s {site.service.time} · {site.address.street}, {site.address.city}</p>
    </nav>
    <div class="header-actions">
      <a class="lang" href={site.links.russian_site} hreflang="ru" lang="ru" title="Русский сайт церкви">
        <Icon name="globe" /><span class="lang-full">Русский</span><span class="lang-short">Рус</span>
      </a>
      <a class="btn btn--sm btn--strong header-cta" href={href('/visit')}>Plan a visit</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
        <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Phone menu. Without JavaScript the toggle is hidden and the links show as a plain list
  // (@media (scripting: none) below). While the menu is open:
  //   - focus moves to the first link, Escape closes it and returns focus to the toggle;
  //   - the skip link, <main> and <footer> are inert, so Tab stays in the header and screen
  //     readers don't wander into the page behind the menu;
  //   - the page behind doesn't scroll.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.getElementById('site-nav');
  if (header && btn && nav) {
    const isOpen = () => header.hasAttribute('data-open');
    const set = (open: boolean, { returnFocus = false } = {}) => {
      if (open === isOpen()) return;
      header.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      for (const el of document.querySelectorAll<HTMLElement>('.skip-link, main, footer')) el.inert = open;
      if (open) nav.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) btn.focus();
    };
    btn.addEventListener('click', () => set(!isOpen()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { e.preventDefault(); set(false, { returnFocus: true }); }
    });
    // A link to a section of the current page (e.g. /ministries/#kids) must close the menu.
    nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>

<style>
  /* The bar's glass (a soft blur and a hairline) is its own layer that fades in by opacity, so
     nothing repaints while scrolling, and the header itself carries no filter (a backdrop-filter on
     it made it the containing block of the fixed phone menu, which got squeezed into the bar).
     Inner pages: the bar runs over the page's title band and melts into it at the top; the glass
     fades in over the first 32 px of scroll (a scroll-driven animation, no script; elsewhere it's
     simply solid). Home: clear over the photo, solid once the photo is behind it
     (src/scripts/motion.ts sets data-solid); without JavaScript it scrolls away with the photo. */
  .site-header { position: sticky; top: 0; z-index: 50; isolation: isolate; color: var(--text); }
  .site-header::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: var(--header-glass);
    -webkit-backdrop-filter: saturate(1.5) blur(18px); backdrop-filter: saturate(1.5) blur(18px);
    border-bottom: 1px solid var(--border); box-shadow: 0 14px 34px -30px rgb(20 26 38 / 0.5); transition: opacity 320ms var(--ease); }
  /* Over the title band only while scripting is on: without it the phone links wrap under the logo
     and the bar is taller than the band's top padding. */
  @media (scripting: enabled) {
    :global(body:has(main > .page-hero:first-child)) .site-header:not(.site-header--overlay) { margin-bottom: calc(-1 * var(--header-h)); }
  }
  @supports (animation-timeline: scroll()) {
    .site-header:not(.site-header--overlay):not([data-open])::before { animation: glass-in var(--scroll-linear) both; animation-timeline: scroll(root); animation-range: 0px 32px; }
  }
  @keyframes glass-in { from { opacity: 0; } to { opacity: 1; } }
  .site-header--overlay { position: absolute; inset: 0 0 auto; color: #fff; }
  :global(.js) .site-header--overlay { position: fixed; }
  .site-header--overlay::before { opacity: 0; }
  .site-header--overlay[data-solid], .site-header--overlay[data-open] { color: var(--text); }
  .site-header--overlay[data-solid]::before, .site-header[data-open]::before { opacity: 1; }
  .site-header[data-open]::before { background: var(--bg); -webkit-backdrop-filter: none; backdrop-filter: none; }
  /* Over the photo: the white focus ring between dark bands. Solid or with the menu open: the normal one. */
  .site-header--overlay:not([data-solid]):not([data-open]) :focus-visible { outline-color: #fff; box-shadow: 0 0 0 4px rgb(5 8 15 / 0.65), 0 0 0 7px rgb(5 8 15 / 0.45); }

  .header-row { display: flex; align-items: center; gap: 0.75rem; min-height: var(--header-h); }

  .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: inherit; margin-right: auto; border-radius: 8px; }
  .brand :global(.brand-mark) { width: 40px; height: 40px; flex: none; }
  .brand-text { display: flex; flex-direction: column; line-height: 1; text-transform: uppercase; }
  .brand-text b { font-size: 1.14rem; font-weight: 800; letter-spacing: 0.01em; white-space: nowrap; }
  .brand-text span { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.32em; margin-top: 4px; opacity: 0.9; }

  .header-actions { display: flex; align-items: center; gap: 0.5rem; }
  .lang { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; min-height: 40px; min-width: 44px; padding: 0 0.8rem; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 0.92rem; color: inherit;
    border: 1px solid color-mix(in srgb, currentColor 24%, transparent); transition: background-color var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease); }
  .lang:hover { background: color-mix(in srgb, currentColor 9%, transparent); border-color: color-mix(in srgb, currentColor 40%, transparent); }
  .lang :global(.icon) { width: 1em; height: 1em; }
  .lang-short { display: none; }
  /* Over the photo the call to action is a light outline; once the bar is solid, the dark pill. */
  .site-header--overlay:not([data-solid]):not([data-open]) .header-cta { border-color: rgb(255 255 255 / 0.62); color: #fff; background: rgb(255 255 255 / 0.08); }
  .site-header--overlay:not([data-solid]):not([data-open]) .header-cta:hover { border-color: #fff; background: rgb(255 255 255 / 0.16); }
  .menu-btn { display: none; width: 48px; height: 48px; border-radius: 999px; border: 0; background: transparent; color: inherit; cursor: pointer; align-items: center; justify-content: center; }
  .menu-btn :global(.icon) { width: 26px; height: 26px; }
  .menu-btn :global(.i-close), [data-open] .menu-btn :global(.i-open) { display: none; }
  [data-open] .menu-btn :global(.i-close) { display: block; }

  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.1rem; }
  .nav a:not(.btn) { position: relative; display: block; padding: 0.55rem 0.75rem; text-decoration: none; font-weight: 600; font-size: 0.97rem; color: inherit; opacity: 0.92; }
  .nav a:not(.btn):hover { opacity: 1; }
  /* A fine underline draws in from the left on hover; the current section keeps it, in the accent
     (white on the Home photo). */
  .nav a:not(.btn)::after { content: ''; position: absolute; left: 0.75rem; right: 0.75rem; bottom: 0.35rem; height: 1.5px; border-radius: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-2) var(--ease); }
  .nav a:not(.btn):hover::after { transform: scaleX(1); }
  .nav a[aria-current]:not(.btn) { opacity: 1; }
  .nav a[aria-current]:not(.btn)::after { transform: scaleX(1); height: 2px; background: var(--accent-text); }
  .site-header--overlay:not([data-solid]) .nav a[aria-current]:not(.btn)::after { background: #fff; }
  .nav-cta, .nav a.nav-sub, .nav-service { display: none; }

  @media (max-width: 1023.98px) {
    .menu-btn { display: inline-flex; }
    .lang-full { display: none; }
    .lang-short { display: inline; }
    .header-cta { display: none; }
    .nav { display: none; }
    [data-open] .nav {
      display: flex; flex-direction: column; gap: 1rem; position: fixed; inset: var(--header-h) 0 0; z-index: 49; padding: 1.25rem var(--gutter) 2rem;
      background: var(--bg); color: var(--text); overflow-y: auto; border-top: 1px solid var(--border);
    }
    [data-open] .nav ul { flex-direction: column; gap: 0; order: 2; }
    [data-open] .nav a:not(.btn) { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; padding: 0.8rem 0; border-bottom: 1px solid var(--border); opacity: 1; }
    [data-open] .nav a:not(.btn)::after { content: none; }
    [data-open] .nav a[aria-current]:not(.btn) { color: var(--accent-text); }
    [data-open] .nav a.nav-sub { display: block; font-size: 1.0625rem; font-weight: 600; letter-spacing: 0; padding: 0.65rem 0 0.65rem 1.25rem; color: var(--text-2); }
    [data-open] .nav-cta { display: inline-flex; order: 1; align-self: stretch; }
    [data-open] .nav-service { display: block; order: 3; margin: 0.5rem 0 0; font-size: 0.9375rem; color: var(--muted); }
    @media (prefers-reduced-motion: no-preference) {
      [data-open] .nav { animation: menu-in 260ms var(--ease) both; }
      [data-open] .nav li { animation: menu-item 420ms var(--ease) both; }
      [data-open] .nav li:nth-child(2) { animation-delay: 30ms; }
      [data-open] .nav li:nth-child(3) { animation-delay: 60ms; }
      [data-open] .nav li:nth-child(4) { animation-delay: 90ms; }
      [data-open] .nav li:nth-child(5) { animation-delay: 120ms; }
      [data-open] .nav li:nth-child(6) { animation-delay: 150ms; }
    }
  }
  @keyframes menu-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes menu-item { from { opacity: 0; translate: 0 8px; } }
  /* "Plan a visit" stays visible next to the menu from 480 px; below that it's the menu's first item. */
  @media (min-width: 480px) and (max-width: 1023.98px) { .header-cta { display: inline-flex; } [data-open] .header-cta { display: none; } }
  @media (min-width: 1024px) and (max-width: 1199.98px) {
    .nav a:not(.btn) { padding-inline: 0.55rem; font-size: 0.94rem; }
    .nav a:not(.btn)::after { left: 0.55rem; right: 0.55rem; }
    .lang :global(.icon) { display: none; }
  }
  @media (max-width: 359.98px) { .lang :global(.icon) { display: none; } .lang { padding: 0 0.6rem; } }
  @media (max-width: 380px) { .brand-text b { font-size: 1rem; } .brand :global(.brand-mark) { width: 34px; height: 34px; } .header-row { gap: 0.5rem; } }
  /* No JavaScript: no toggle; the links wrap under the logo instead. */
  @media (scripting: none) and (max-width: 1023.98px) {
    .menu-btn { display: none; }
    .header-row { flex-wrap: wrap; padding-bottom: 0.5rem; }
    .nav { display: block; order: 3; flex-basis: 100%; }
    .nav ul { flex-wrap: wrap; gap: 0 0.1rem; margin-left: -0.75rem; }
  }
</style>
