---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { buildTime, type SyncedEvent } from '../lib/content';
import { registrationStatus, registrationLabel, eventPath } from '../lib/events.mjs';
import { dateBadge, formatRange } from '../lib/time.mjs';
import { syncedImage, CARD_WIDTHS } from '../lib/media';
import { href } from '../lib/url';

interface Props {
  event: SyncedEvent;
  layout?: 'wide' | 'tile';
  headingLevel?: 'h2' | 'h3';
  eager?: boolean; // the first card on a page is usually the LCP element: load it right away
}
const { event: e, layout = 'tile', headingLevel: H = 'h3', eager = false } = Astro.props;
const page = href(eventPath(e)); // the event's own page on this site (full description, JSON-LD)
const image = syncedImage(e.image);
const sizes = layout === 'wide' ? '(min-width: 1240px) 580px, (min-width: 820px) 46vw, 100vw' : '(min-width: 1240px) 380px, (min-width: 960px) 30vw, (min-width: 640px) 46vw, 100vw';
const badge = e.starts_at ? dateBadge(e.starts_at) : null;
const when = formatRange(e);
const where = e.location ? [e.location.name, e.location.address].filter(Boolean).join(' · ') : null;
const canRegister = registrationStatus(e, buildTime) === 'open';
const status = registrationLabel(e, buildTime);
const ext = { target: '_blank', rel: 'noopener' };
---
<article class:list={['event', `event--${layout}`]}>
  <div class="event-media">
    {image
      ? <Picture src={image} alt="" widths={CARD_WIDTHS} sizes={sizes} formats={['avif', 'webp']} class="media-16x9"
          loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
      : <div class="media-16x9 event-noimg" aria-hidden="true"><Icon name="calendar" /></div>}
  </div>
  <div class="event-body">
    <div class="event-head">
      {badge && <div class="badge" aria-hidden="true"><span>{badge.month}</span><b>{badge.day}</b><span>{badge.weekday}</span></div>}
      <div>
        <p class="event-when"><Icon name="clock" /><span>{when}</span></p>
        <H class="event-title"><a href={page}>{e.title}</a></H>
      </div>
    </div>
    {where && <p class="event-where"><Icon name="pin" /><span>{where}</span></p>}
    <div class="event-chips">
      {e.price && <span class="chip">{e.price.label}</span>}
      {status && <span class="chip">{status}</span>}
      {e.more_times.length > 0 && <span class="chip">+{e.more_times.length} more {e.more_times.length === 1 ? 'date' : 'dates'}</span>}
    </div>
    {e.summary && <p class="event-summary">{e.summary}</p>}
    <div class="btn-row event-actions">
      {canRegister && <a class="btn btn--primary btn--sm" href={e.register_url} {...ext}>Register<span class="visually-hidden"> for {e.title} (opens Church Center)</span></a>}
      <a class:list={['btn btn--sm', canRegister ? 'btn--outline' : 'btn--primary']} href={page}>
        Details<span class="visually-hidden"> about {e.title}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .event { display: grid; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .event-media { position: relative; }
  .event-media :global(img), .event-noimg { height: 100%; }
  .event-noimg { display: grid; place-items: center; color: var(--muted); }
  .event-noimg :global(.icon) { width: 40px; height: 40px; }
  .event-head { display: flex; gap: 1rem; align-items: center; }
  .badge { display: grid; justify-items: center; align-content: center; flex: none; min-width: 64px; padding: 8px 10px; border-radius: 14px; background: var(--bg-tint); color: var(--text); line-height: 1.1; }
  .badge span { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em; color: var(--accent-text); }
  .badge b { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.02em; }
  .event-body { display: flex; flex-direction: column; gap: 0.5rem; padding: clamp(18px, 2.4vw, 28px); }
  .event-when, .event-where { display: flex; gap: 0.5rem; align-items: flex-start; margin: 0; font-weight: 600; font-size: 0.95rem; }
  .event-when { color: var(--accent-text); }
  .event-where { color: var(--text-2); font-weight: 500; }
  .event-when :global(.icon), .event-where :global(.icon) { margin-top: 0.2em; }
  .event-title { margin: 0.2rem 0 0; font-size: var(--step-2); }
  .event-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .event-chips:empty { display: none; }
  .event-summary { margin: 0.25rem 0 0; color: var(--text-2); }
  .event-actions { margin-top: auto; padding-top: 0.75rem; }
  .event-title a { text-decoration: none; }
  .event-title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 820px) {
    .event--wide { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .event--wide .event-media { padding: clamp(12px, 1.6vw, 18px) 0 clamp(12px, 1.6vw, 18px) clamp(12px, 1.6vw, 18px); }
    .event--wide .event-media :global(img), .event--wide .event-noimg { border-radius: calc(var(--radius) - 6px); }
  }
</style>
